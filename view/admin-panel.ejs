<!doctype html>
<html lang="en" dir="ltr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light">
    <title>DigiStore Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Vazirmatn:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.34.0/tabler-icons.min.css">
    <style>
        :root {
            --canvas: #f5f7f4;
            --surface: #ffffff;
            --ink: #171b18;
            --muted: #66706a;
            --subtle: #8b948f;
            --line: #d9ded9;
            --line-strong: #c4ccc6;
            --primary: #0f9f78;
            --primary-dark: #087457;
            --primary-soft: #ddf5ec;
            --danger: #e34b6a;
            --danger-soft: #fff0f3;
            --warning: #a86618;
            --warning-soft: #fff8e8;
            --shadow: 0 12px 34px rgba(23, 27, 24, 0.06);
            --radius: 14px;
            --font-ltr: "Inter", system-ui, sans-serif;
            --font-rtl: "Vazirmatn", Tahoma, sans-serif;
        }

        * { box-sizing: border-box; }
        html { scroll-behavior: smooth; }
        body {
            margin: 0;
            min-width: 320px;
            background: var(--canvas);
            color: var(--ink);
            font-family: var(--font-ltr);
            line-height: 1.5;
        }
        html[dir="rtl"] body { font-family: var(--font-rtl); }
        button, input, textarea { font: inherit; }
        button { cursor: pointer; }
        button:disabled { cursor: not-allowed; opacity: 0.62; }
        a { color: inherit; }
        ::selection { background: var(--primary-soft); color: var(--primary-dark); }

        .topbar {
            position: sticky;
            top: 0;
            z-index: 20;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 24px;
            min-height: 72px;
            padding: 12px clamp(18px, 4vw, 56px);
            background: rgba(255, 255, 255, 0.96);
            border-bottom: 1px solid var(--line);
            backdrop-filter: blur(12px);
        }
        .brand {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            min-width: max-content;
            text-decoration: none;
        }
        .brand-mark {
            display: grid;
            place-items: center;
            width: 34px;
            height: 34px;
            border-radius: 10px;
            background: var(--ink);
            color: var(--primary-soft);
        }
        .brand-copy { display: grid; gap: 0; }
        .brand-name { font-size: 13px; font-weight: 700; letter-spacing: -0.02em; }
        .brand-subtitle { color: var(--muted); font-size: 10px; }
        .main-nav {
            display: flex;
            align-items: center;
            gap: 4px;
            min-width: 0;
            overflow-x: auto;
            scrollbar-width: none;
        }
        .main-nav::-webkit-scrollbar { display: none; }
        .nav-link {
            position: relative;
            display: inline-flex;
            align-items: center;
            gap: 7px;
            min-height: 44px;
            padding: 0 13px;
            color: var(--muted);
            font-size: 12px;
            font-weight: 600;
            text-decoration: none;
            white-space: nowrap;
            transition: color 160ms ease;
        }
        .nav-link::after {
            position: absolute;
            right: 12px;
            bottom: -13px;
            left: 12px;
            height: 2px;
            background: transparent;
            content: "";
        }
        .nav-link:hover, .nav-link:focus-visible { color: var(--ink); }
        .nav-link.is-active { color: var(--primary-dark); }
        .nav-link.is-active::after { background: var(--primary); }
        .topbar-actions { display: flex; align-items: center; gap: 8px; min-width: max-content; }
        .language-switch {
            display: inline-flex;
            align-items: center;
            gap: 2px;
            padding: 3px;
            background: var(--canvas);
            border: 1px solid var(--line);
            border-radius: 999px;
        }
        .language-button {
            min-width: 35px;
            min-height: 32px;
            padding: 0 8px;
            border: 0;
            border-radius: 999px;
            background: transparent;
            color: var(--muted);
            font-size: 11px;
            font-weight: 700;
        }
        .language-button.is-active { background: var(--surface); color: var(--ink); box-shadow: 0 1px 3px rgba(23, 27, 24, 0.1); }
        .status-pill, .status-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            min-height: 32px;
            padding: 0 10px;
            border-radius: 999px;
            font-size: 11px;
            font-weight: 600;
            white-space: nowrap;
        }
        .status-pill { background: var(--primary-soft); color: var(--primary-dark); }
        .status-pill::before, .status-badge::before { width: 6px; height: 6px; border-radius: 50%; background: currentColor; content: ""; }
        .status-badge.active { background: var(--primary-soft); color: var(--primary-dark); }
        .status-badge.paused { background: #eef0ef; color: var(--muted); }
        .status-badge.unavailable { background: var(--warning-soft); color: var(--warning); }

        .page {
            width: min(1360px, 100%);
            margin: 0 auto;
            padding: clamp(28px, 5vw, 68px) clamp(18px, 4vw, 56px) 34px;
        }
        .page-intro {
            display: flex;
            align-items: end;
            justify-content: space-between;
            gap: 24px;
            padding-bottom: 28px;
            border-bottom: 1px solid var(--line);
        }
        .eyebrow {
            margin: 0 0 8px;
            color: var(--primary-dark);
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 0.14em;
            text-transform: uppercase;
        }
        html[dir="rtl"] .eyebrow { letter-spacing: 0; }
        h1, h2, h3, p { margin-top: 0; }
        h1 {
            max-width: 760px;
            margin-bottom: 9px;
            font-size: clamp(28px, 4vw, 48px);
            line-height: 1.1;
            letter-spacing: -0.055em;
        }
        html[dir="rtl"] h1, html[dir="rtl"] h2, html[dir="rtl"] h3 { letter-spacing: 0; }
        .page-subtitle { max-width: 680px; margin-bottom: 0; color: var(--muted); font-size: 14px; }
        .intro-actions { display: grid; justify-items: end; gap: 10px; }
        .sync-note { color: var(--muted); font-size: 11px; }

        .button {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            min-height: 44px;
            padding: 0 15px;
            border: 1px solid transparent;
            border-radius: 9px;
            font-size: 12px;
            font-weight: 700;
            transition: background 160ms ease, border-color 160ms ease, color 160ms ease, transform 160ms ease;
        }
        .button:hover { transform: translateY(-1px); }
        .button-primary { background: var(--primary); color: #fff; }
        .button-primary:hover { background: var(--primary-dark); }
        .button-secondary { background: var(--surface); border-color: var(--line-strong); color: var(--ink); }
        .button-secondary:hover { border-color: var(--primary); color: var(--primary-dark); }
        .button-danger { background: var(--danger); color: #fff; }
        .button-danger:hover { background: #c83857; }
        .button-full { width: 100%; }
        .icon-button {
            display: inline-grid;
            place-items: center;
            width: 40px;
            height: 40px;
            padding: 0;
            border: 1px solid var(--line);
            border-radius: 9px;
            background: var(--surface);
            color: var(--muted);
        }
        .icon-button:hover { color: var(--primary-dark); border-color: var(--primary); }
        .icon-button.danger { color: var(--danger); border-color: #f3c6ce; background: var(--danger-soft); }
        .icon-button.danger:hover { background: var(--danger); color: #fff; border-color: var(--danger); }
        .button:focus-visible, .icon-button:focus-visible, .language-button:focus-visible, .nav-link:focus-visible, input:focus-visible, textarea:focus-visible {
            outline: 3px solid rgba(15, 159, 120, 0.24);
            outline-offset: 2px;
        }

        .metric-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 12px;
            margin: 22px 0 28px;
        }
        .metric {
            display: flex;
            align-items: center;
            justify-content: space-between;
            min-height: 88px;
            gap: 20px;
            padding: 17px 20px;
            background: var(--surface);
            border: 1px solid var(--line);
            border-left: 3px solid var(--primary);
            border-radius: 10px;
        }
        html[dir="rtl"] .metric { border-right: 3px solid var(--primary); border-left: 1px solid var(--line); }
        .metric.warning { border-left-color: var(--warning); }
        html[dir="rtl"] .metric.warning { border-right-color: var(--warning); }
        .metric-label { margin: 0 0 4px; color: var(--muted); font-size: 10px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; }
        html[dir="rtl"] .metric-label { letter-spacing: 0; }
        .metric-value { margin: 0; font-size: 22px; font-weight: 700; letter-spacing: -0.04em; }
        .metric-detail { color: var(--primary-dark); font-size: 11px; font-weight: 600; text-align: end; }
        .metric.warning .metric-detail { color: var(--warning); }

        .content-section { scroll-margin-top: 96px; margin-top: 28px; }
        .section-heading {
            display: flex;
            align-items: end;
            justify-content: space-between;
            gap: 16px;
            margin-bottom: 14px;
        }
        .section-heading h2 { margin-bottom: 5px; font-size: 23px; letter-spacing: -0.04em; }
        .section-description { margin-bottom: 0; color: var(--muted); font-size: 12px; }
        .section-tools { display: flex; align-items: center; gap: 8px; }
        .endpoint { direction: ltr; text-align: left; color: var(--muted); font-family: "DM Mono", ui-monospace, monospace; font-size: 10px; }
        .endpoint-badge { display: inline-flex; align-items: center; min-height: 27px; padding: 0 8px; border: 1px solid var(--line); border-radius: 6px; background: var(--canvas); }
        .section-layout { display: grid; grid-template-columns: minmax(240px, 0.34fr) minmax(0, 0.66fr); gap: 14px; }
        .panel { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); box-shadow: var(--shadow); }
        .panel-header { display: flex; align-items: start; justify-content: space-between; gap: 16px; padding: 19px 21px; border-bottom: 1px solid var(--line); }
        .panel-title { margin-bottom: 3px; font-size: 15px; font-weight: 700; }
        .panel-copy { margin-bottom: 0; color: var(--muted); font-size: 11px; }
        .panel-body { padding: 20px 21px; }
        .form-grid { display: grid; gap: 14px; }
        .field { display: grid; gap: 6px; }
        .field label { font-size: 11px; font-weight: 700; }
        .required { color: var(--danger); }
        .field input, .field textarea, .search-input {
            width: 100%;
            min-height: 44px;
            padding: 10px 12px;
            border: 1px solid var(--line-strong);
            border-radius: 8px;
            background: var(--surface);
            color: var(--ink);
            font-size: 12px;
            transition: border-color 160ms ease, box-shadow 160ms ease;
        }
        .field textarea { min-height: 104px; resize: vertical; }
        .field input:hover, .field textarea:hover, .search-input:hover { border-color: var(--primary); }
        .field input::placeholder, .field textarea::placeholder, .search-input::placeholder { color: #a0a8a3; }
        .field-help { margin: -1px 0 0; color: var(--muted); font-size: 10px; }
        .form-actions { display: grid; gap: 9px; margin-top: 4px; }
        .form-note { margin: 0; color: var(--muted); font-size: 10px; text-align: center; }
        .table-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 17px 19px; border-bottom: 1px solid var(--line); }
        .table-toolbar-actions { display: flex; align-items: center; gap: 8px; }
        .search-wrap { position: relative; min-width: min(210px, 40vw); }
        .search-wrap .ti { position: absolute; top: 50%; left: 11px; color: var(--muted); transform: translateY(-50%); }
        html[dir="rtl"] .search-wrap .ti { right: 11px; left: auto; }
        .search-input { min-height: 36px; padding-left: 32px; }
        html[dir="rtl"] .search-input { padding-right: 32px; padding-left: 12px; }
        .checkbox-control { display: inline-flex; align-items: center; gap: 7px; color: var(--muted); font-size: 11px; white-space: nowrap; }
        .checkbox-control input { accent-color: var(--primary); }
        .table-scroll { overflow-x: auto; }
        table { width: 100%; border-collapse: collapse; min-width: 680px; }
        th, td { padding: 14px 18px; border-bottom: 1px solid #edf0ed; text-align: start; vertical-align: middle; }
        th { background: #fbfcfb; color: var(--muted); font-size: 9px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; white-space: nowrap; }
        html[dir="rtl"] th { letter-spacing: 0; }
        td { color: var(--ink); font-size: 12px; }
        tbody tr:hover { background: #fbfdfb; }
        .code-value { direction: ltr; font-family: "DM Mono", ui-monospace, monospace; font-size: 11px; font-weight: 700; text-align: start; }
        .muted-cell { color: var(--muted); }
        .table-footer { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 12px 18px; color: var(--muted); font-size: 10px; }
        .empty-state, .loading-state { padding: 32px 20px; color: var(--muted); font-size: 12px; text-align: center; }
        .empty-state .ti, .loading-state .ti { display: block; margin-bottom: 8px; color: var(--primary); font-size: 20px; }

        .messages-alert {
            display: flex;
            align-items: start;
            gap: 12px;
            margin-bottom: 14px;
            padding: 14px 16px;
            border: 1px solid #edc6cf;
            border-radius: 10px;
            background: var(--danger-soft);
            color: #8d3048;
        }
        .alert-icon { display: grid; place-items: center; flex: 0 0 auto; width: 30px; height: 30px; border-radius: 8px; background: #ffdce4; color: var(--danger); }
        .alert-title { margin: 0 0 3px; font-size: 12px; font-weight: 700; }
        .alert-copy { margin: 0; font-size: 11px; }
        .operation-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
        .operation-card { display: flex; flex-direction: column; min-width: 0; padding: 18px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); box-shadow: var(--shadow); }
        .operation-card.danger { border-color: #edc6cf; }
        .operation-card-header { display: flex; align-items: start; justify-content: space-between; gap: 12px; min-height: 56px; margin-bottom: 15px; padding-bottom: 13px; border-bottom: 1px solid var(--line); }
        .operation-verb { margin-bottom: 4px; color: var(--primary-dark); font-size: 9px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; }
        html[dir="rtl"] .operation-verb { letter-spacing: 0; }
        .danger .operation-verb { color: var(--danger); }
        .operation-title { margin: 0; font-size: 15px; }
        .operation-card .form-actions { margin-top: auto; padding-top: 18px; }
        .location-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
        .probe-card { min-width: 0; padding: 19px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); box-shadow: var(--shadow); }
        .probe-header { display: flex; align-items: start; justify-content: space-between; gap: 12px; margin-bottom: 16px; }
        .probe-title-row { display: flex; align-items: center; gap: 9px; }
        .probe-icon { display: grid; place-items: center; width: 31px; height: 31px; border-radius: 8px; background: var(--primary-soft); color: var(--primary-dark); }
        .probe-title { margin: 0; font-size: 14px; }
        .probe-subtitle { margin: 2px 0 0; color: var(--muted); font-size: 10px; }
        .response-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; padding: 15px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
        .response-item { min-width: 0; }
        .response-label { display: block; margin-bottom: 3px; color: var(--muted); font-size: 9px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; }
        html[dir="rtl"] .response-label { letter-spacing: 0; }
        .response-value { display: block; min-height: 20px; overflow-wrap: anywhere; color: var(--ink); font-size: 12px; font-weight: 600; }
        .response-value.endpoint-value { direction: ltr; font-family: "DM Mono", ui-monospace, monospace; font-size: 10px; text-align: start; }
        .probe-message { min-height: 63px; margin: 14px 0 0; padding: 10px 12px; border-radius: 8px; background: var(--primary-soft); color: var(--primary-dark); font-size: 11px; }
        .probe-message[dir="auto"] { text-align: start; }
        .probe-footer { display: flex; justify-content: end; margin-top: 14px; }
        .feedback {
            position: fixed;
            right: 20px;
            bottom: 20px;
            z-index: 30;
            display: grid;
            gap: 3px;
            max-width: min(360px, calc(100vw - 40px));
            padding: 13px 15px;
            border: 1px solid var(--line-strong);
            border-radius: 10px;
            background: var(--surface);
            box-shadow: var(--shadow);
            opacity: 0;
            pointer-events: none;
            transform: translateY(8px);
            transition: opacity 160ms ease, transform 160ms ease;
        }
        html[dir="rtl"] .feedback { right: auto; left: 20px; }
        .feedback.is-visible { opacity: 1; pointer-events: auto; transform: translateY(0); }
        .feedback.success { border-color: #a9dfca; }
        .feedback.error { border-color: #edc6cf; }
        .feedback-title { margin: 0; font-size: 12px; font-weight: 700; }
        .feedback-copy { margin: 0; color: var(--muted); font-size: 11px; }
        footer { display: flex; justify-content: space-between; gap: 18px; padding-top: 28px; color: var(--muted); font-size: 10px; }

        @media (max-width: 1050px) {
            .topbar { flex-wrap: wrap; gap: 8px 18px; }
            .main-nav { order: 3; flex-basis: 100%; }
            .nav-link::after { bottom: -1px; }
            .section-layout { grid-template-columns: 1fr; }
        }
        @media (max-width: 760px) {
            .page-intro, .section-heading { align-items: start; flex-direction: column; }
            .intro-actions { justify-items: start; }
            html[dir="rtl"] .intro-actions { justify-items: start; }
            .metric-grid, .operation-grid, .location-grid { grid-template-columns: 1fr; }
            .table-toolbar { align-items: stretch; flex-direction: column; }
            .table-toolbar-actions { justify-content: space-between; }
            .search-wrap { min-width: 0; flex: 1; }
            .section-tools { flex-wrap: wrap; }
            footer { flex-direction: column; }
        }
        @media (max-width: 520px) {
            .topbar { padding: 10px 14px; }
            .topbar-actions { width: 100%; justify-content: space-between; }
            .page { padding: 26px 14px 28px; }
            h1 { font-size: 31px; }
            .metric { min-height: 78px; padding: 14px 15px; }
            .panel-header, .panel-body, .operation-card, .probe-card { padding: 16px; }
            .table-toolbar-actions { align-items: stretch; flex-direction: column; }
            .checkbox-control { min-height: 36px; }
        }

        .auth-section {
            display: grid;
            place-items: center;
            min-height: calc(100vh - 72px);
            padding: 40px clamp(18px, 4vw, 56px);
        }
        .auth-card {
            width: min(400px, 100%);
            padding: 28px 24px;
            background: var(--surface);
            border: 1px solid var(--line);
            border-radius: var(--radius);
            box-shadow: var(--shadow);
        }
        .auth-card h2 {
            margin: 0 0 6px;
            font-size: 20px;
            letter-spacing: -0.04em;
        }
        .auth-card p {
            margin: 0 0 18px;
            color: var(--muted);
            font-size: 12px;
        }
        .auth-card .form-grid {
            display: grid;
            gap: 12px;
        }
        .logout-button {
            gap: 6px;
            padding: 0 10px;
            border: 1px solid var(--line);
            border-radius: 9px;
            background: var(--surface);
            color: var(--muted);
            font-size: 11px;
            font-weight: 600;
        }
        .logout-button:hover {
            border-color: var(--danger);
            color: var(--danger);
            background: var(--danger-soft);
        }
    </style>
</head>
<body>
    <div class="app-shell">
        <header class="topbar">
            <a class="brand" href="#overview" aria-label="DigiStore admin home">
                <span class="brand-mark"><i class="ti ti-layout-dashboard" aria-hidden="true"></i></span>
                <span class="brand-copy">
                    <span class="brand-name" data-i18n="brandName">DigiStore</span>
                    <span class="brand-subtitle" data-i18n="brandSubtitle">Admin surface</span>
                </span>
            </a>

            <nav class="main-nav" aria-label="Primary navigation">
                <a class="nav-link is-active" href="#discounts"><i class="ti ti-ticket" aria-hidden="true"></i><span data-i18n="navDiscounts">Discounts</span></a>
                <a class="nav-link" href="#products"><i class="ti ti-package" aria-hidden="true"></i><span data-i18n="navProducts">Products</span></a>
                <a class="nav-link" href="#cart"><i class="ti ti-shopping-cart" aria-hidden="true"></i><span data-i18n="navCart">Cart</span></a>
                <a class="nav-link" href="#messages"><i class="ti ti-message-2" aria-hidden="true"></i><span data-i18n="navMessages">Messages</span></a>
                <a class="nav-link" href="#location"><i class="ti ti-map-pin" aria-hidden="true"></i><span data-i18n="navLocation">Location</span></a>
            </nav>

            <div class="topbar-actions">
                <% if (isAuthenticated) { %>
                <button class="logout-button" id="logout-button" type="button" data-i18n-title="logout" aria-label="Logout" title="Logout"><i class="ti ti-logout" aria-hidden="true"></i><span data-i18n="logout">Logout</span></button>
                <% } %>
                <div class="language-switch" role="group" aria-label="Language selector">
                    <button class="language-button is-active" type="button" data-lang-switch="en" aria-pressed="true">EN</button>
                    <button class="language-button" type="button" data-lang-switch="fa" aria-pressed="false">FA</button>
                </div>
                <span class="status-pill"><span data-i18n="apiOnline">API online</span></span>
                <button class="icon-button" id="refresh-button" type="button" data-i18n-title="refresh" aria-label="Refresh data" title="Refresh data"><i class="ti ti-refresh" aria-hidden="true"></i></button>
            </div>
        </header>

        <% if (!isAuthenticated) { %>
        <section class="auth-section">
            <form class="auth-card" id="login-form" method="POST" action="/api/admin/login" novalidate>
                <h2 data-i18n="loginTitle">Admin login</h2>
                <p data-i18n="loginSubtitle">Sign in to access the control surface.</p>
                <div class="form-grid">
