beTitle: "بررسی موقعیت", eligibilityProbeTitle: "بررسی واجد شرایط بودن", waiting: "در انتظار", ipLabel: "IP", countryLabel: "کشور", regionLabel: "استان", cityLabel: "شهر", coordinatesLabel: "مختصات", discountLabel: "تخفیف", runLocation: "آزمایش API موقعیت", checkEligibility: "بررسی واجد شرایط بودن تخفیف", probeWaiting: "برای دیدن پاسخ API، بررسی واجد شرایط بودن را اجرا کنید.", locationReady: "آماده", eligibilityReady: "واجد شرایط", probeError: "بررسی ناموفق بود", footerNote: "پنل مدیریت دیجی‌استور · سطح عملیاتی", refreshSuccess: "پنل به‌روزرسانی شد", refreshError: "به‌روزرسانی ناموفق بود", createSuccess: "کد تخفیف ایجاد شد", messageCreated: "پیام ایجاد شد", messageUpdated: "پیام ویرایش شد", messageDeleted: "پیام حذف شد", requestError: "درخواست ناموفق بود", locationSuccess: "موقعیت دریافت شد", eligibilitySuccess: "واجد شرایط بودن دریافت شد", languageEnglish: "انگلیسی", languagePersian: "فارسی",
                    tableName: "نام", tablePrice: "قیمت", tableStock: "موجودی", tableCategory: "دسته‌بندی", cartLiveNote: "داده‌ها به‌صورت زنده از API بارگذاری می‌شوند.", logout: "خروج", navCart: "سبد خرید", navProducts: "محصولات", cartDeleteConfirm: "آیا از حذف این آیتم سبد خرید اطمینان دارید؟", deleteProduct: "حذف محصول", tableQuantity: "تعداد",                }
            };

            const state = { language: "en", discounts: [], messages: [], products: [], cartItems: [], cartItemsFiltered: [], activeOnly: false, search: "" };
            const translate = (key) => translations[state.language][key] || translations.en[key] || key;
            const byId = (id) => document.getElementById(id);
            const escapeHtml = (value) => String(value ?? "—").replace(/[&<>'"]/g, (character) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", "'": "&#39;", '"': "&quot;" }[character]));
            const formatDate = (value) => {
                if (!value) return "—";
                const date = new Date(value);
                if (Number.isNaN(date.getTime())) return escapeHtml(value);
                return new Intl.DateTimeFormat(state.language === "fa" ? "fa-IR" : "en-US", { year: "numeric", month: "short", day: "numeric" }).format(date);
            };
            const formatCount = (count) => translate("tableRows").replace("{count}", new Intl.NumberFormat(state.language === "fa" ? "fa-IR" : "en-US").format(count));

            function applyTranslations() {
                document.documentElement.lang = state.language === "fa" ? "fa" : "en";
                document.documentElement.dir = state.language === "fa" ? "rtl" : "ltr";
                document.title = `DigiStore · ${state.language === "fa" ? "مدیریت" : "Admin"}`;
                document.querySelectorAll("[data-i18n]").forEach((element) => { element.textContent = translate(element.dataset.i18n); });
                document.querySelectorAll("[data-i18n-placeholder]").forEach((element) => { element.placeholder = translate(element.dataset.i18nPlaceholder); });
                document.querySelectorAll("[data-i18n-title]").forEach((element) => { element.title = translate(element.dataset.i18nTitle); });
                document.querySelectorAll("[data-lang-switch]").forEach((button) => {
                    const active = button.dataset.langSwitch === state.language;
                    button.classList.toggle("is-active", active);
                    button.setAttribute("aria-pressed", String(active));
                });
                if (byId("discount-table-body")) renderDiscounts();
                if (byId("discount-detail")) updateMetricLabels();
            }

            function updateMetricLabels() {
                const detail = byId("discount-detail");
                if (!detail) return;
                if (state.discounts.length) detail.textContent = `${state.discounts.filter((item) => item.is_active !== false).length} ${state.language === "fa" ? "فعال" : "active"}`;
                else detail.textContent = translate("loading");
                const countElement = byId("discount-count");
                if (countElement) countElement.textContent = state.discounts.length ? new Intl.NumberFormat(state.language === "fa" ? "fa-IR" : "en-US").format(state.discounts.length) : "—";
            }

            function showFeedback(title, copy, type = "success") {
                const feedback = byId("feedback");
                byId("feedback-title").textContent = title;
                byId("feedback-copy").textContent = copy;
                feedback.className = `feedback ${type} is-visible`;
                window.clearTimeout(showFeedback.timeout);
                showFeedback.timeout = window.setTimeout(() => feedback.classList.remove("is-visible"), 4200);
            }

            function renderDiscounts() {
                const body = byId("discount-table-body");
                if (!body) return;
                const search = state.search.trim().toLowerCase();
                const filtered = state.discounts.filter((discount) => {
                    const matchesSearch = !search || String(discount.code || "").toLowerCase().includes(search);
                    const matchesActive = !state.activeOnly || discount.is_active !== false;
                    return matchesSearch && matchesActive;
                });
                updateMetricLabels();
                const tableCount = byId("table-count");
                if (tableCount) tableCount.textContent = formatCount(filtered.length);
                if (!filtered.length) {
                    body.innerHTML = `<tr><td class="empty-state" colspan="6"><i class="ti ti-database-off" aria-hidden="true"></i><span>${escapeHtml(translate("noDiscounts"))}</span></td></tr>`;
                    return;
                }
                body.innerHTML = filtered.map((discount) => {
                    const isActive = discount.is_active !== false;
                    return `<tr>
                        <td class="code-value">${escapeHtml(discount.code)}</td>
                        <td>${escapeHtml(discount.percent)}%</td>
                        <td>${escapeHtml(discount.user_per_use ?? 1)}</td>
                        <td><span class="status-badge ${isActive ? "active" : "paused"}">${escapeHtml(translate(isActive ? "active" : "paused"))}</span></td>
                        <td class="muted-cell">${formatDate(discount.createdAt || discount.created_at)}</td>
                        <td><button class="icon-button danger" type="button" data-action="delete-discount" data-id="${discount.id}" aria-label="${escapeHtml(translate("deleteDiscount"))}"><i class="ti ti-trash" aria-hidden="true"></i></button></td>
                    </tr>`;
                }).join("");
            }

            function setTableLoading() {
                const body = byId("discount-table-body");
                if (!body) return;
                body.innerHTML = `<tr><td class="loading-state" colspan="6"><i class="ti ti-loader-2" aria-hidden="true"></i><span>${escapeHtml(translate("loading"))}</span></td></tr>`;
            }

            async function readJson(response) {
                const payload = await response.json().catch(() => ({}));
                if (!response.ok || payload.success === false) throw new Error(payload.message || translate("requestError"));
                return payload;
            }

            async function loadDiscounts() {
                setTableLoading();
                try {
                    const payload = await readJson(await fetch("/api/v1/discount/all/get", { headers: { Accept: "application/json" } }));
                    state.discounts = Array.isArray(payload.data) ? payload.data : [];
                    const syncNote = byId("sync-note");
                    if (syncNote) syncNote.textContent = translate("syncUpdated");
                    renderDiscounts();
                } catch (error) {
                    state.discounts = [];
                    const body = byId("discount-table-body");
                    if (body) body.innerHTML = `<tr><td class="empty-state" colspan="6"><i class="ti ti-alert-circle" aria-hidden="true"></i><span>${escapeHtml(error.message || translate("tableLoadError"))}</span></td></tr>`;
                    const tableCount = byId("table-count");
                    if (tableCount) tableCount.textContent = "—";
                    updateMetricLabels();
                    const syncNote = byId("sync-note");
                    if (syncNote) syncNote.textContent = translate("refreshError");
                }
            }

            async function loadMessages() {
                const body = byId("messages-table-body");
                if (!body) return;
                body.innerHTML = `<tr><td class="loading-state" colspan="4"><i class="ti ti-loader-2" aria-hidden="true"></i><span>${escapeHtml(translate("loading"))}</span></td></tr>`;
                try {
                    const payload = await readJson(await fetch("/api/v1/messages/all/get", { headers: { Accept: "application/json" } }));
                    state.messages = Array.isArray(payload.data) ? payload.data : [];
                    renderMessages();
                } catch (error) {
                    state.messages = [];
                    body.innerHTML = `<tr><td class="empty-state" colspan="4"><i class="ti ti-alert-circle" aria-hidden="true"></i><span>${escapeHtml(error.message || translate("tableLoadError"))}</span></td></tr>`;
                    const messagesTableCount = byId("messages-table-count");
                    if (messagesTableCount) messagesTableCount.textContent = "—";
                }
            }

            function renderMessages() {
                const body = byId("messages-table-body");
                if (!body) return;
                const messagesTableCount = byId("messages-table-count");
                if (messagesTableCount) messagesTableCount.textContent = translate("messagesTableCount").replace("{count}", new Intl.NumberFormat(state.language === "fa" ? "fa-IR" : "en-US").format(state.messages.length));
                if (!state.messages.length) {
                    body.innerHTML = `<tr><td class="empty-state" colspan="4"><i class="ti ti-database-off" aria-hidden="true"></i><span>${escapeHtml(translate("noMessages"))}</span></td></tr>`;
                    return;
                }
                body.innerHTML = state.messages.map((message) => {
                    return `<tr>
                        <td class="muted-cell">${escapeHtml(message.id)}</td>
                        <td>${escapeHtml(message.title)}</td>
                        <td>${escapeHtml(message.desc)}</td>
                        <td class="muted-cell">${formatDate(message.createdAt || message.created_at)}</td>
                    </tr>`;
                }).join("");
            }

            async function submitJson(form, url, method, successKey) {
                const submitButton = form.querySelector("button[type=submit]");
                submitButton.disabled = true;
                try {
                    const data = Object.fromEntries(new FormData(form).entries());
                    const payload = method === "DELETE" ? undefined : JSON.stringify(data);
                    const response = await fetch(url, { method, headers: payload ? { "Content-Type": "application/json", Accept: "application/json" } : { Accept: "application/json" }, body: payload });
                    await readJson(response);
                    form.reset();
                    showFeedback(translate(successKey), translate(successKey), "success");
                    if (url.includes("discount")) await loadDiscounts();
                    if (url.includes("message")) await loadMessages();
                    if (url.includes("product")) await loadProducts();
                    if (url.includes("cart")) await loadCart();
                } catch (error) {
                    showFeedback(translate("requestError"), error.message || translate("requestError"), "error");
                } finally {
                    submitButton.disabled = false;
                }
            }

            async function runLocationProbe() {
                const button = byId("location-button");
                button.disabled = true;
                try {
                    const payload = await readJson(await fetch("/api/v1/location/get", { headers: { Accept: "application/json" } }));
                    const data = payload.data || {};
                    byId("location-ip").textContent = data.ip || "—";
                    byId("location-country").textContent = data.country || "—";
                    byId("location-region").textContent = data.region || "—";
                    byId("location-city").textContent = data.city || "—";
                    byId("location-coordinates").textContent = Array.isArray(data.coordinates) ? data.coordinates.map((value) => Number(value).toFixed(4)).join(", ") : "—";
                    byId("location-status").textContent = translate("locationReady");
                    byId("location-status").className = "status-badge active";
                    showFeedback(translate("locationSuccess"), data.city || translate("locationSuccess"));
                } catch (error) {
                    byId("location-status").textContent = translate("probeError");
                    byId("location-status").className = "status-badge unavailable";
                    showFeedback(translate("probeError"), error.message || translate("requestError"), "error");
                } finally { button.disabled = false; }
            }

            async function runEligibilityProbe() {
                const button = byId("eligibility-button");
                button.disabled = true;
                try {
                    const payload = await readJson(await fetch("/api/v1/discount/location/get", { headers: { Accept: "application/json" } }));
                    byId("eligibility-city").textContent = payload.city || "—";
                    byId("eligibility-country").textContent = payload.country || "—";
                    byId("eligibility-discount").textContent = `${payload.discount ?? 0}%`;
                    byId("eligibility-message").textContent = payload.message || "—";
                    byId("eligibility-status").textContent = payload.discount > 0 ? translate("eligibilityReady") : translate("readOnly");
                    byId("eligibility-status").className = `status-badge ${payload.discount > 0 ? "active" : "paused"}`;
                    showFeedback(translate("eligibilitySuccess"), `${payload.city || "—"} · ${payload.discount ?? 0}%`);
                } catch (error) {
                    byId("eligibility-status").textContent = translate("probeError");
                    byId("eligibility-status").className = "status-badge unavailable";
                    showFeedback(translate("probeError"), error.message || translate("requestError"), "error");
                } finally { button.disabled = false; }
            }

            async function deleteDiscountCode(id) {
                if (!confirm(translate("deleteConfirm"))) return;
                try {
                    await readJson(await fetch(`/api/v1/discount/delete/${encodeURIComponent(id)}`, { method: "DELETE", headers: { Accept: "application/json" } }));
                    showFeedback(translate("deleteSuccess"), translate("deleteSuccess"), "success");
                    await loadDiscounts();
                } catch (error) {
                    showFeedback(translate("deleteError"), error.message || translate("deleteError"), "error");
                }
            }

            async function loadProducts() {
                const body = byId("products-table-body");
                if (!body) return;
                body.innerHTML = `<tr><td class="loading-state" colspan="7"><i class="ti ti-loader-2" aria-hidden="true"></i><span>${escapeHtml(translate("loading"))}</span></td></tr>`;
                try {
                    const payload = await readJson(await fetch("/api/v1/products/all/get", { headers: { Accept: "application/json" } }));
                    state.products = Array.isArray(payload.data) ? payload.data : [];
                    renderProducts();
                } catch (error) {
                    state.products = [];
                    body.innerHTML = `<tr><td class="empty-state" colspan="7"><i class="ti ti-alert-circle" aria-hidden="true"></i><span>${escapeHtml(error.message || translate("tableLoadError"))}</span></td></tr>`;
                    byId("products-table-count").textContent = "—";
                }
            }

            function renderProducts() {
                const body = byId("products-table-body");
                if (!body) return;
                byId("products-table-count").textContent = translate("productsTableCount").replace("{count}", new Intl.NumberFormat(state.language === "fa" ? "fa-IR" : "en-US").format(state.products.length));
                if (!state.products.length) {
                    body.innerHTML = `<tr><td class="empty-state" colspan="7"><i class="ti ti-database-off" aria-hidden="true"></i><span>${escapeHtml(translate("noProducts"))}</span></td></tr>`;
                    return;
                }
                body.innerHTML = state.products.map((product) => {
                    const isActive = product.is_active !== false;
                    return `<tr>
                        <td>${escapeHtml(product.name)}</td>
                        <td>${escapeHtml(product.price)}</td>
                        <td>${escapeHtml(product.stock ?? 0)}</td>
                        <td>${escapeHtml(product.category || "—")}</td>
                        <td><span class="status-badge ${isActive ? "active" : "paused"}">${escapeHtml(translate(isActive ? "active" : "paused"))}</span></td>
                        <td class="muted-cell">${formatDate(product.createdAt || product.created_at)}</td>
                        <td>
                            <button class="icon-button" type="button" data-action="update-product" data-id="${product.id}" aria-label="${escapeHtml(translate("updateProduct"))}"><i class="ti ti-edit" aria-hidden="true"></i></button>
                            <button class="icon-button danger" type="button" data-action="delete-product" data-id="${product.id}" aria-label="${escapeHtml(translate("deleteProduct"))}"><i class="ti ti-trash" aria-hidden="true"></i></button>
                        </td>
                    </tr>`;
                }).join("");
            }

            async function loadCart() {
                const body = byId("cart-table-body");
                if (!body) return;
                body.innerHTML = `<tr><td class="loading-state" colspan="7"><i class="ti ti-loader-2" aria-hidden="true"></i><span>${escapeHtml(translate("loading"))}</span></td></tr>`;
                try {
                    const payload = await readJson(await fetch("/api/v1/cart/all/get", { headers: { Accept: "application/json" } }));
                    state.cartItems = Array.isArray(payload.data) ? payload.data : [];
                    renderCart();
                } catch (error) {
                    state.cartItems = [];
                    body.innerHTML = `<tr><td class="empty-state" colspan="7"><i class="ti ti-alert-circle" aria-hidden="true"></i><span>${escapeHtml(error.message || translate("tableLoadError"))}</span></td></tr>`;
                    byId("cart-table-count").textContent = "—";
                }
            }

            function renderCart() {
                const body = byId("cart-table-body");
                if (!body) return;
                byId("cart-table-count").textContent = translate("cartTableCount").replace("{count}", new Intl.NumberFormat(state.language === "fa" ? "fa-IR" : "en-US").format(state.cartItems.length));
                if (!state.cartItems.length) {
                    body.innerHTML = `<tr><td class="empty-state" colspan="7"><i class="ti ti-database-off" aria-hidden="true"></i><span>${escapeHtml(translate("noCartItems"))}</span></td></tr>`;
                    return;
                }
                body.innerHTML = state.cartItems.map((item) => {
                    const product = item.product || {};
                    const subtotal = (product.price || 0) * (item.quantity || 0);
                    return `<tr>
                        <td class="muted-cell">${escapeHtml(item.id)}</td>
                        <td>${escapeHtml(item.session_id)}</td>
                        <td>${escapeHtml(product.name || "—")}</td>
                        <td>${escapeHtml(item.quantity)}</td>
                        <td>${escapeHtml(product.price || 0)}</td>
                        <td>${escapeHtml(subtotal)}</td>
                        <td><button class="icon-button danger" type="button" data-action="delete-cart-item" data-id="${item.id}" aria-label="${escapeHtml(translate("cartDeleteSuccess"))}"><i class="ti ti-trash" aria-hidden="true"></i></button></td>
                    </tr>`;
                }).join("");
            }


            async function submitLogin(event) {
                event.preventDefault();
                const form = event.currentTarget;
                const button = form.querySelector("button[type=submit]");
                button.disabled = true;
                try {
                    const data = Object.fromEntries(new FormData(form).entries());
                    const payload = await readJson(await fetch("/api/admin/login", { method: "POST", headers: { "Content-Type": "application/json", Accept: "application/json" }, body: JSON.stringify(data) }));
                    showFeedback(translate("loginSuccess"), translate("loginSuccess"), "success");
                    setTimeout(() => location.reload(), 600);
                } catch (error) {
                    showFeedback(translate("loginError"), error.message || translate("loginError"), "error");
                } finally {
                    button.disabled = false;
                }
            }

            async function submitLogout() {
                try {
                    await readJson(await fetch("/api/admin/logout", { method: "POST", headers: { Accept: "application/json" } }));
                    showFeedback(translate("logoutSuccess"), translate("logoutSuccess"), "success");
                    setTimeout(() => location.reload(), 600);
                } catch (error) {
                    showFeedback(translate("requestError"), error.message || translate("requestError"), "error");
                }
            }

            document.querySelectorAll("[data-lang-switch]").forEach((button) => button.addEventListener("click", () => {
                state.language = button.dataset.langSwitch;
                applyTranslations();
            }));
            document.querySelectorAll("[data-scroll-target]").forEach((button) => button.addEventListener("click", () => document.querySelector(button.dataset.scrollTarget)?.scrollIntoView({ behavior: "smooth", block: "center" })));
            const discountSearch = byId("discount-search");
            if (discountSearch) discountSearch.addEventListener("input", (event) => { state.search = event.target.value; renderDiscounts(); });
            const activeOnly = byId("active-only");
            if (activeOnly) activeOnly.addEventListener("change", (event) => { state.activeOnly = event.target.checked; renderDiscounts(); });
            const refreshButton = byId("refresh-button");
            if (refreshButton) refreshButton.addEventListener("click", async () => { if (byId("discount-table-body")) await loadDiscounts(); showFeedback(translate("refreshSuccess"), translate("syncUpdated")); });
            const refreshMessagesButton = byId("refresh-messages-button");
            if (refreshMessagesButton) refreshMessagesButton.addEventListener("click", async () => { await loadMessages(); showFeedback(translate("refreshSuccess"), translate("syncUpdated")); });
            const discountTableBody = byId("discount-table-body");
            if (discountTableBody) discountTableBody.addEventListener("click", (event) => {
                const button = event.target.closest("button[data-action='delete-discount']");
                if (button) {
                    const id = button.dataset.id;
                    if (id) deleteDiscountCode(id);
                }
            });
            const discountForm = byId("discount-form");
            if (discountForm) discountForm.addEventListener("submit", (event) => { event.preventDefault(); submitJson(event.currentTarget, "/api/v1/discount/create", "POST", "createSuccess"); });
            const messageCreateForm = byId("message-create-form");
            if (messageCreateForm) messageCreateForm.addEventListener("submit", (event) => { event.preventDefault(); submitJson(event.currentTarget, "/api/v1/messages/create", "POST", "messageCreated"); });
            const messageUpdateForm = byId("message-update-form");
            if (messageUpdateForm) messageUpdateForm.addEventListener("submit", (event) => {
                event.preventDefault();
                const id = byId("update-message-id").value.trim();
                if (!id) { showFeedback(translate("requestError"), translate("messageIdLabel"), "error"); return; }
                submitJson(event.currentTarget, `/api/v1/messages/update/${encodeURIComponent(id)}`, "PUT", "messageUpdated");
            });
            const messageDeleteForm = byId("message-delete-form");
            if (messageDeleteForm) messageDeleteForm.addEventListener("submit", (event) => {
                event.preventDefault();
                const id = byId("delete-message-id").value.trim();
                if (!id) { showFeedback(translate("requestError"), translate("messageIdLabel"), "error"); return; }
                submitJson(event.currentTarget, `/api/v1/messages/delete/${encodeURIComponent(id)}`, "DELETE", "messageDeleted");
            });
            const locationButton = byId("location-button");
            if (locationButton) locationButton.addEventListener("click", runLocationProbe);
            const eligibilityButton = byId("eligibility-button");
            if (eligibilityButton) eligibilityButton.addEventListener("click", runEligibilityProbe);

            const productForm = byId("product-form");
            if (productForm) productForm.addEventListener("submit", (event) => { event.preventDefault(); submitJson(event.currentTarget, "/api/v1/products/create", "POST", "productCreateSuccess"); });
            const refreshProductsButton = byId("refresh-products-button");
            if (refreshProductsButton) refreshProductsButton.addEventListener("click", async () => { await loadProducts(); showFeedback(translate("refreshSuccess"), translate("syncUpdated")); });
            const productsTableBody = byId("products-table-body");
            if (productsTableBody) productsTableBody.addEventListener("click", async (event) => {
                const updateButton = event.target.closest("button[data-action='update-product']");
                const deleteButton = event.target.closest("button[data-action='delete-product']");
                if (updateButton) {
                    const id = updateButton.dataset.id;
                    const newName = prompt("Enter new product name:");
                    if (!newName) return;
                    const newPrice = prompt("Enter new price:", "0");
                    if (newPrice === null) return;
                    try {
                        await readJson(await fetch(`/api/v1/products/update/${encodeURIComponent(id)}`, {
                            method: "PUT",
                            headers: { "Content-Type": "application/json", Accept: "application/json" },
                            body: JSON.stringify({ name: newName, price: newPrice })
                        }));
                        showFeedback(translate("productUpdateSuccess"), translate("productUpdateSuccess"), "success");
                        await loadProducts();
                    } catch (error) {
                        showFeedback(translate("requestError"), error.message || translate("requestError"), "error");
                    }
                }
                if (deleteButton) {
                    const id = deleteButton.dataset.id;
                    if (!confirm(translate("productDeleteConfirm"))) return;
                    try {
                        await readJson(await fetch(`/api/v1/products/delete/${encodeURIComponent(id)}`, { method: "DELETE", headers: { Accept: "application/json" } }));
                        showFeedback(translate("productDeleteSuccess"), translate("productDeleteSuccess"), "success");
                        await loadProducts();
                    } catch (error) {
                        showFeedback(translate("requestError"), error.message || translate("requestError"), "error");
                    }
                }
            });

            const cartForm = byId("cart-form");
            if (cartForm) cartForm.addEventListener("submit", (event) => { event.preventDefault(); submitJson(event.currentTarget, "/api/v1/cart/add", "POST", "cartAddSuccess"); });
            const refreshCartButton = byId("refresh-cart-button");
            if (refreshCartButton) refreshCartButton.addEventListener("click", async () => { await loadCart(); showFeedback(translate("refreshSuccess"), translate("syncUpdated")); });
            const clearCartButton = byId("clear-cart-button");
            if (clearCartButton) clearCartButton.addEventListener("click", async () => {
                if (!confirm(translate("cartClearConfirm"))) return;
                try {
                    const sessionInput = byId("cart-session");
                    const session_id = sessionInput ? sessionInput.value.trim() : "";
                    if (!session_id) {
                        showFeedback(translate("requestError"), translate("cartSessionLabel"), "error");
                        return;
                    }
                    await readJson(await fetch("/api/v1/cart/clear", { method: "POST", headers: { "Content-Type": "application/json", Accept: "application/json" }, body: JSON.stringify({ session_id }) }));
                    showFeedback(translate("cartClearSuccess"), translate("cartClearSuccess"), "success");
                    await loadCart();
                } catch (error) {
                    showFeedback(translate("requestError"), error.message || translate("requestError"), "error");
                }
            });
            const cartTableBody = byId("cart-table-body");
            if (cartTableBody) cartTableBody.addEventListener("click", async (event) => {
                const button = event.target.closest("button[data-action='delete-cart-item']");
                if (button) {
                    const id = button.dataset.id;
                    if (!confirm(translate("cartDeleteConfirm"))) return;
                    readJson(await fetch(`/api/v1/cart/delete/${encodeURIComponent(id)}`, { method: "DELETE", headers: { Accept: "application/json" } })).then(() => {
                        showFeedback(translate("cartDeleteSuccess"), translate("cartDeleteSuccess"), "success");
                        loadCart();
                    }).catch((error) => showFeedback(translate("requestError"), error.message || translate("requestError"), "error"));
                }
            });
            const cartSearchInput = byId("cart-search");
            if (cartSearchInput) cartSearchInput.addEventListener("input", (event) => {
                const term = event.target.value.trim().toLowerCase();
                const filtered = state.cartItems.filter((item) => String(item.session_id || "").toLowerCase().includes(term));
                state.cartItemsFiltered = filtered;
                renderCartFiltered();
            });

            function renderCartFiltered() {
                const body = byId("cart-table-body");
                if (!body) return;
                const items = state.cartItemsFiltered || state.cartItems;
                if (!items.length) {
                    body.innerHTML = `<tr><td class="empty-state" colspan="7"><i class="ti ti-database-off" aria-hidden="true"></i><span>${escapeHtml(translate("noCartItems"))}</span></td></tr>`;
                    return;
                }
                body.innerHTML = items.map((item) => {
                    const product = item.product || {};
                    const subtotal = (product.price || 0) * (item.quantity || 0);
                    return `<tr>
                        <td class="muted-cell">${escapeHtml(item.id)}</td>
                        <td>${escapeHtml(item.session_id)}</td>
                        <td>${escapeHtml(product.name || "—")}</td>
                        <td>${escapeHtml(item.quantity)}</td>
                        <td>${escapeHtml(product.price || 0)}</td>
                        <td>${escapeHtml(subtotal)}</td>
                        <td><button class="icon-button danger" type="button" data-action="delete-cart-item" data-id="${item.id}" aria-label="${escapeHtml(translate("cartDeleteSuccess"))}"><i class="ti ti-trash" aria-hidden="true"></i></button></td>
                    </tr>`;
                }).join("");
            }
            const loginForm = byId("login-form");
            if (loginForm) loginForm.addEventListener("submit", submitLogin);
            const logoutButton = byId("logout-button");
            if (logoutButton) logoutButton.addEventListener("click", submitLogout);

            try { applyTranslations(); } catch (e) { console.error("Translation error:", e); }
            setTimeout(() => {
                try {
                    if (byId("discount-table-body")) loadDiscounts();
                    if (byId("messages-table-body")) loadMessages();
                    if (byId("products-table-body")) loadProducts();
                    if (byId("cart-table-body")) loadCart();
                } catch (e) {
                    console.error("Data load error:", e);
                }
            }, 0);
            } catch (error) {
                console.error("Admin panel init error:", error);
            }
        })();
    </script>
</body>
</html>
