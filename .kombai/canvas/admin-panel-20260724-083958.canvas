1-2-1-3\" role=\"tab\">\n                                    Delete\n                                </button>\n                            </div>\n                            <form aria-label=\"Create in-app message\" class=\"mt-5 grid gap-4\" data-kid=\"1-1-2-1-4-1-2-2\">\n                                <div data-kid=\"1-1-2-1-4-1-2-2-1\">\n                                    <label class=\"block text-xs font-semibold text-slate-700\" data-kid=\"1-1-2-1-4-1-2-2-1-1\" for=\"message-title\">\n                                        Title\n                                        <span class=\"text-blue-600\" data-kid=\"1-1-2-1-4-1-2-2-1-1-1\">\n                                            *\n                                        </span>\n                                    </label>\n                                    <input class=\"mt-1.5 h-11 w-full rounded-lg border border-slate-200 bg-white px-3 text-sm text-slate-900 placeholder:text-slate-400 focus:border-blue-500 focus:outline-none focus:ring-3 focus:ring-blue-500/15\" data-kid=\"1-1-2-1-4-1-2-2-1-2\" id=\"message-title\" name=\"title\" placeholder=\"Weekend offer is live\" type=\"text\"/>\n                                </div>\n                                <div data-kid=\"1-1-2-1-4-1-2-2-2\">\n                                    <label class=\"block text-xs font-semibold text-slate-700\" data-kid=\"1-1-2-1-4-1-2-2-2-1\" for=\"message-desc\">\n                                        Description\n                                        <span class=\"text-blue-600\" data-kid=\"1-1-2-1-4-1-2-2-2-1-1\">\n                                            *\n                                        </span>\n                                    </label>\n                                    <textarea class=\"mt-1.5 w-full resize-none rounded-lg border border-slate-200 bg-white px-3 py-3 text-sm text-slate-900 placeholder:text-slate-400 focus:border-blue-500 focus:outline-none focus:ring-3 focus:ring-blue-500/15\" data-kid=\"1-1-2-1-4-1-2-2-2-2\" id=\"message-desc\" name=\"desc\" placeholder=\"Share a short message with customers\" rows=\"3\"></textarea>\n                                </div>\n                                <div class=\"flex flex-col gap-3 border-t border-slate-100 pt-4 sm:flex-row sm:items-center sm:justify-between\" data-kid=\"1-1-2-1-4-1-2-2-3\">\n                                    <p class=\"font-mono text-[10px] text-slate-500\" data-kid=\"1-1-2-1-4-1-2-2-3-1\">\n                                        POST /api/v1/messages/create\n                                    </p>\n                                    <button class=\"inline-flex min-h-11 items-center justify-center gap-2 rounded-lg bg-blue-600 px-4 text-sm font-semibold text-white hover:bg-blue-700 focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-blue-500/30\" data-kid=\"1-1-2-1-4-1-2-2-3-2\" type=\"submit\">\n                                        <i aria-hidden=\"true\" class=\"ti ti-send text-[16px] text-white\" data-kid=\"1-1-2-1-4-1-2-2-3-2-1\">\n                                        </i>\n                                        Create message\n                                    </button>\n                                </div>\n                            </form>\n                        </div>\n                    </div>\n                    <div class=\"border border-amber-200 bg-amber-50/70 shadow-xs\" data-kid=\"1-1-2-1-4-2\">\n                        <div class=\"border-b border-amber-200 px-5 py-5\" data-kid=\"1-1-2-1-4-2-1\">\n                            <div class=\"flex items-start gap-3\" data-kid=\"1-1-2-1-4-2-1-1\">\n                                <div class=\"flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-amber-100\" data-kid=\"1-1-2-1-4-2-1-1-1\">\n                                    <i aria-hidden=\"true\" class=\"ti ti-alert-triangle text-[18px] text-amber-700\" data-kid=\"1-1-2-1-4-2-1-1-1-1\">\n                                    </i>\n                                </div>\n                                <div data-kid=\"1-1-2-1-4-2-1-1-2\">\n                                    <h2 class=\"text-base font-semibold text-amber-950\" data-kid=\"1-1-2-1-4-2-1-1-2-1\">\n                                        Blind operations\n                                    </h2>\n                                    <p class=\"mt-1 text-xs leading-5 text-amber-800\" data-kid=\"1-1-2-1-4-2-1-1-2-2\">\n                                        Message list unavailable in current API.\n                                    </p>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"space-y-4 p-5\" data-kid=\"1-1-2-1-4-2-2\">\n                            <p class=\"text-xs leading-5 text-amber-900/80\" data-kid=\"1-1-2-1-4-2-2-1\">\n                                There is no GET messages endpoint. Update and delete actions require an exact message ID from another source.\n                            </p>\n                            <div class=\"border-t border-amber-200 pt-4\" data-kid=\"1-1-2-1-4-2-2-2\">\n                                <label class=\"block text-xs font-semibold text-amber-950\" data-kid=\"1-1-2-1-4-2-2-2-1\" for=\"message-id\">\n                                    Target message ID\n                                </label>\n                                <div class=\"mt-1.5 flex gap-2\" data-kid=\"1-1-2-1-4-2-2-2-2\">\n                                    <input class=\"h-11 min-w-0 flex-1 rounded-lg border border-amber-200 bg-white px-3 font-mono text-[13px] text-slate-900 placeholder:text-slate-400 focus:border-amber-500 focus:outline-none focus:ring-3 focus:ring-amber-500/20\" data-kid=\"1-1-2-1-4-2-2-2-2-1\" id=\"message-id\" placeholder=\"e.g. 42\" type=\"number\"/>\n                                    <button aria-label=\"Use message ID\" class=\"inline-flex min-h-11 items-center justify-center rounded-lg border border-amber-300 bg-white px-3 text-amber-800 hover:bg-amber-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-500\" data-kid=\"1-1-2-1-4-2-2-2-2-2\" title=\"Use message ID\">\n                                        <i aria-hidden=\"true\" class=\"ti ti-arrow-right text-[17px] text-amber-700\" data-kid=\"1-1-2-1-4-2-2-2-2-2-1\">\n                                        </i>\n                                    </button>\n                                </div>\n                                <p class=\"mt-1.5 font-mono text-[10px] text-amber-800/75\" data-kid=\"1-1-2-1-4-2-2-2-3\">\n                                    PUT /api/v1/messages/update/:id\n                                </p>\n                            </div>\n                            <div class=\"flex items-start justify-between gap-3 border-t border-amber-200 pt-4\" data-kid=\"1-1-2-1-4-2-2-3\">\n                                <div data-kid=\"1-1-2-1-4-2-2-3-1\">\n                                    <p class=\"text-xs font-semibold text-amber-950\" data-kid=\"1-1-2-1-4-2-2-3-1-1\">\n                                        Delete action\n                                    </p>\n                                    <p class=\"mt-1 font-mono text-[10px] text-amber-800/75\" data-kid=\"1-1-2-1-4-2-2-3-1-2\">\n                                        DELETE /api/v1/messages/delete/:id\n                                    </p>\n                                </div>\n                                <button class=\"inline-flex min-h-11 items-center justify-center gap-2 rounded-lg border border-rose-300 bg-white px-3 text-xs font-semibold text-rose-700 hover:bg-rose-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-rose-500\" data-kid=\"1-1-2-1-4-2-2-3-2\">\n                                    <i aria-hidden=\"true\" class=\"ti ti-trash text-[16px] text-rose-600\" data-kid=\"1-1-2-1-4-2-2-3-2-1\">\n                                    </i>\n                                    Delete\n                                </button>\n                            </div>\n                        </div>\n                    </div>\n                </section>\n                <section class=\"mt-7 border border-slate-200 bg-white shadow-xs\" data-kid=\"1-1-2-1-5\" id=\"location\">\n                    <div class=\"flex flex-col gap-3 border-b border-slate-200 px-5 py-5 sm:flex-row sm:items-end sm:justify-between\" data-kid=\"1-1-2-1-5-1\">\n                        <div data-kid=\"1-1-2-1-5-1-1\">\n                            <div class=\"flex items-center gap-2\" data-kid=\"1-1-2-1-5-1-1-1\">\n                                <i aria-hidden=\"true\" class=\"ti ti-map-pin-check text-[20px] text-blue-600\" data-kid=\"1-1-2-1-5-1-1-1-1\">\n                                </i>\n                                <h2 class=\"text-base font-semibold text-slate-950\" data-kid=\"1-1-2-1-5-1-1-1-2\">\n                                    Location & eligibility probes\n                                </h2>\n                            </div>\n                            <p class=\"mt-1.5 text-xs text-slate-500\" data-kid=\"1-1-2-1-5-1-1-2\">\n                                Read-only checks for IP location and city-based discount bindings.\n                            </p>\n                        </div>\n                        <span class=\"inline-flex w-fit items-center gap-1.5 rounded-full bg-slate-100 px-2.5 py-1 text-[11px] font-semibold text-slate-600\" data-kid=\"1-1-2-1-5-1-2\">\n                            <i aria-hidden=\"true\" class=\"ti ti-lock text-[13px] text-slate-500\" data-kid=\"1-1-2-1-5-1-2-1\">\n                            </i>\n                            Read-only\n                        </span>\n                    </div>\n                    <div class=\"grid divide-y divide-slate-200 md:grid-cols-2 md:divide-x md:divide-y-0\" data-kid=\"1-1-2-1-5-2\">\n                        <div class=\"p-5\" data-kid=\"1-1-2-1-5-2-1\">\n                            <div class=\"flex items-center justify-between gap-3\" data-kid=\"1-1-2-1-5-2-1-1\">\n                                <div data-kid=\"1-1-2-1-5-2-1-1-1\">\n                                    <h3 class=\"text-sm font-semibold text-slate-900\" data-kid=\"1-1-2-1-5-2-1-1-1-1\">\n                                        Current location\n                                    </h3>\n                                    <p class=\"mt-1 font-mono text-[10px] text-slate-500\" data-kid=\"1-1-2-1-5-2-1-1-1-2\">\n                                        GET /api/v1/location/get\n                                    </p>\n                                </div>\n                                <button class=\"inline-flex min-h-11 items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-3 text-xs font-semibold text-slate-700 hover:bg-slate-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500\" data-kid=\"1-1-2-1-5-2-1-1-2\">\n                                    <i aria-hidden=\"true\" class=\"ti ti-radar-2 text-[16px] text-blue-600\" data-kid=\"1-1-2-1-5-2-1-1-2-1\">\n                                    </i>\n                                    Run location probe\n                                </button>\n                            </div>\n                            <dl class=\"mt-5 grid grid-cols-2 gap-x-5 gap-y-4\" data-kid=\"1-1-2-1-5-2-1-2\">\n                                <div data-kid=\"1-1-2-1-5-2-1-2-1\">\n                                    <dt class=\"text-[10px] font-semibold uppercase tracking-[0.12em] text-slate-400\" data-kid=\"1-1-2-1-5-2-1-2-1-1\">\n                                        IP\n                                    </dt>\n                                    <dd class=\"mt-1 font-mono text-xs text-slate-800\" data-dynamic=\"true\" data-kid=\"1-1-2-1-5-2-1-2-1-2\" data-name=\"IP address text\" data-reason=\"text updated via API\">\n                                        8.8.8.8\n                                    </dd>\n                                </div>\n                                <div data-kid=\"1-1-2-1-5-2-1-2-2\">\n                                    <dt class=\"text-[10px] font-semibold uppercase tracking-[0.12em] text-slate-400\" data-kid=\"1-1-2-1-5-2-1-2-2-1\">\n                                        Country\n                                    </dt>\n                                    <dd class=\"mt-1 text-sm font-medium text-slate-800\" data-dynamic=\"true\" data-kid=\"1-1-2-1-5-2-1-2-2-2\" data-name=\"country text\" data-reason=\"text updated via API\">\n                                        IR\n                                    </dd>\n                                </div>\n                                <div data-kid=\"1-1-2-1-5-2-1-2-3\">\n                                    <dt class=\"text-[10px] font-semibold uppercase tracking-[0.12em] text-slate-400\" data-kid=\"1-1-2-1-5-2-1-2-3-1\">\n                                        Region\n                                    </dt>\n                                    <dd class=\"mt-1 text-sm font-medium text-slate-800\" data-dynamic=\"true\" data-kid=\"1-1-2-1-5-2-1-2-3-2\" data-name=\"region text\" data-reason=\"text updated via API\">\n                                        Tehran\n                                    </dd>\n                                </div>\n                                <div data-kid=\"1-1-2-1-5-2-1-2-4\">\n                                    <dt class=\"text-[10px] font-semibold uppercase tracking-[0.12em] text-slate-400\" data-kid=\"1-1-2-1-5-2-1-2-4-1\">\n                                        Coordinates\n                                    </dt>\n                                    <dd class=\"mt-1 font-mono text-xs text-slate-800\" data-dynamic=\"true\" data-kid=\"1-1-2-1-5-2-1-2-4-2\" data-name=\"coordinates text\" data-reason=\"text updated via API\">\n                                        35.6892, 51.3890\n                                    </dd>\n                                </div>\n                            </dl>\n                        </div>\n                        <div class=\"p-5\" data-kid=\"1-1-2-1-5-2-2\">\n                            <div class=\"flex items-center justify-between gap-3\" data-kid=\"1-1-2-1-5-2-2-1\">\n                                <div data-kid=\"1-1-2-1-5-2-2-1-1\">\n                                    <h3 class=\"text-sm font-semibold text-slate-900\" data-kid=\"1-1-2-1-5-2-2-1-1-1\">\n                                        Discount eligibility\n                                    </h3>\n                                    <p class=\"mt-1 font-mono text-[10px] text-slate-500\" data-kid=\"1-1-2-1-5-2-2-1-1-2\">\n                                        GET /api/v1/discount/location/get\n                                    </p>\n                                </div>\n                                <button class=\"inline-flex min-h-11 items-center justify-center gap-2 rounded-lg bg-slate-900 px-3 text-xs font-semibold text-white hover:bg-slate-800 focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-slate-900/25\" data-kid=\"1-1-2-1-5-2-2-1-2\">\n                                    <i aria-hidden=\"true\" class=\"ti ti-discount-2 text-[16px] text-white\" data-kid=\"1-1-2-1-5-2-2-1-2-1\">\n                                    </i>\n                                    Check eligibility\n                                </button>\n                            </div>\n                            <div class=\"mt-5 flex items-start gap-3 rounded-lg border border-emerald-200 bg-emerald-50 p-3.5\" data-kid=\"1-1-2-1-5-2-2-2\">\n                                <div class=\"flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-emerald-100\" data-kid=\"1-1-2-1-5-2-2-2-1\">\n                                    <i aria-hidden=\"true\" class=\"ti ti-check text-[18px] text-emerald-700\" data-kid=\"1-1-2-1-5-2-2-2-1-1\">\n                                    </i>\n                                </div>\n                                <div data-kid=\"1-1-2-1-5-2-2-2-2\">\n                                    <p class=\"text-sm font-semibold text-emerald-900\" data-dynamic=\"true\" data-kid=\"1-1-2-1-5-2-2-2-2-1\" data-name=\"discount eligibility status text\" data-reason=\"text updated via API\">\n                                        20% eligible\n                                    </p>\n                                    <p class=\"mt-1 text-xs leading-5 text-emerald-800\" data-dynamic=\"true\" data-kid=\"1-1-2-1-5-2-2-2-2-2\" data-name=\"discount eligibility description text\" data-reason=\"text updated via API\">\n                                        چون از شهر تهران هستید شما شامل 20 درصد تخفیف روی قیمت کل شدید!\n                                    </p>\n                                </div>\n                            </div>\n                            <p class=\"mt-4 text-[11px] text-slate-500\" data-dynamic=\"true\" data-kid=\"1-1-2-1-5-2-2-3\" data-name=\"eligibility response timestamp/status\" data-reason=\"text updated via API\">\n                                Last response: Tehran · success: true\n                            </p>\n                        </div>\n                    </div>\n                </section>\n                <footer class=\"flex flex-col gap-2 border-t border-slate-200 py-6 text-[11px] text-slate-400 sm:flex-row sm:items-center sm:justify-between\" data-kid=\"1-1-2-1-6\">\n                    <span data-kid=\"1-1-2-1-6-1\">\n                        DigiStore operations console\n                    </span>\n                    <span class=\"font-mono\" data-kid=\"1-1-2-1-6-2\">\n                        Express API · EJS view · live surface\n                    </span>\n                </footer>\n            </div>\n        </main>\n    </div>\n</div>\n",
