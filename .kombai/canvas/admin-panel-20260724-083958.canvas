der border-slate-200 bg-slate-50 pl-9 pr-3 text-sm text-slate-900 placeholder:text-slate-400 focus:border-blue-500 focus:outline-none focus:ring-3 focus:ring-blue-500/15 sm:w-52\" data-kid=\"1-1-2-1-3-1-2-1-3\" placeholder=\"Search code\" type=\"search\"/>\n                            </label>\n                            <button class=\"inline-flex min-h-11 items-center justify-center gap-2 rounded-lg bg-blue-600 px-4 text-sm font-semibold text-white shadow-sm shadow-blue-600/20 hover:bg-blue-700 focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-blue-500/30\" data-kid=\"1-1-2-1-3-1-2-2\">\n                                <i aria-hidden=\"true\" class=\"ti ti-plus text-[17px] text-white\" data-kid=\"1-1-2-1-3-1-2-2-1\">\n                                </i>\n                                Add discount\n                            </button>\n                        </div>\n                    </div>\n                    <div class=\"grid gap-0 xl:grid-cols-[minmax(0,1fr)_280px]\" data-kid=\"1-1-2-1-3-2\">\n                        <div class=\"min-w-0 border-b border-slate-200 xl:border-b-0 xl:border-r\" data-kid=\"1-1-2-1-3-2-1\">\n                            <div class=\"overflow-x-auto\" data-kid=\"1-1-2-1-3-2-1-1\">\n                                <table class=\"w-full min-w-[680px] text-left text-sm\" data-kid=\"1-1-2-1-3-2-1-1-1\">\n                                    <caption class=\"sr-only\" data-kid=\"1-1-2-1-3-2-1-1-1-1\">\n                                        Discount code inventory\n                                    </caption>\n                                    <thead class=\"border-b border-slate-200 bg-slate-50 text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-500\" data-kid=\"1-1-2-1-3-2-1-1-1-2\">\n                                        <tr data-kid=\"1-1-2-1-3-2-1-1-1-2-1\">\n                                            <th class=\"px-5 py-3\" data-kid=\"1-1-2-1-3-2-1-1-1-2-1-1\" scope=\"col\">\n                                                Code\n                                            </th>\n                                            <th class=\"px-4 py-3\" data-kid=\"1-1-2-1-3-2-1-1-1-2-1-2\" scope=\"col\">\n                                                Percent\n                                            </th>\n                                            <th class=\"px-4 py-3\" data-kid=\"1-1-2-1-3-2-1-1-1-2-1-3\" scope=\"col\">\n                                                Uses per user\n                                            </th>\n                                            <th class=\"px-4 py-3\" data-kid=\"1-1-2-1-3-2-1-1-1-2-1-4\" scope=\"col\">\n                                                Status\n                                            </th>\n                                            <th class=\"px-4 py-3\" data-kid=\"1-1-2-1-3-2-1-1-1-2-1-5\" scope=\"col\">\n                                                Created\n                                            </th>\n                                            <th class=\"px-4 py-3 text-right\" data-kid=\"1-1-2-1-3-2-1-1-1-2-1-6\" scope=\"col\">\n                                                Actions\n                                            </th>\n                                        </tr>\n                                    </thead>\n                                    <tbody class=\"divide-y divide-slate-100\" data-dynamic=\"true\" data-kid=\"1-1-2-1-3-2-1-1-1-3\" data-name=\"discount code table body\" data-reason=\"rows populated via API\">\n                                        <tr class=\"hover:bg-slate-50\" data-kid=\"1-1-2-1-3-2-1-1-1-3-1\">\n                                            <td class=\"px-5 py-4 font-mono text-[13px] font-medium text-slate-900\" data-kid=\"1-1-2-1-3-2-1-1-1-3-1-1\">\n                                                SPRING20\n                                            </td>\n                                            <td class=\"px-4 py-4 f