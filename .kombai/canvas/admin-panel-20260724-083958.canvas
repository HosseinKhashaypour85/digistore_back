        "x": 2760,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<link data-kid=\"1\" data-name=\"webfont stylesheet link\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<style>\n    @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@600;700;800&display=swap');\n</style>\n<div class=\"min-h-screen bg-[var(--canvas)] text-[var(--ink)]\" data-kid=\"2\" data-name=\"admin page wrapper\" style=\"--canvas:#f8f8f6;--surface:#ffffff;--ink:#171717;--muted:#6d6d68;--line:#d0d0cc;--soft:#f1f1ed;--emerald:#10B981;--emerald-ink:#065f46;--rose:#F43F5E;--rose-ink:#9f1239;--rose-soft:#fff1f2;--amber-soft:#fff7ed;--amber-line:#fed7aa;--font-heading:'Manrope',sans-serif;--font-body:'DM Sans',sans-serif;font-family:var(--font-body)\">\n    <header class=\"sticky top-0 z-30 border-b border-[var(--line)] bg-[var(--surface)]\" data-kid=\"2-1\" data-name=\"sticky header\">\n        <div class=\"mx-auto flex max-w-[1440px] items-center gap-5 px-4 py-3 sm:px-6 lg:px-8\" data-kid=\"2-1-1\" data-name=\"header layout container\">\n            <div class=\"flex shrink-0 items-center gap-3\" data-kid=\"2-1-1-1\" data-name=\"brand logo container\">\n                <div class=\"flex h-9 w-9 items-center justify-center rounded-lg bg-[var(--ink)] text-[var(--emerald)]\" data-kid=\"2-1-1-1-1\" data-name=\"brand icon box\">\n                    <i aria-hidden=\"true\" class=\"ti ti-layout-dashboard text-[18px] text-[var(--emerald)]\" data-kid=\"2-1-1-1-1-1\" data-name=\"dashboard layout icon\" style=\"width:18px;height:18px\">\n                    </i>\n                </div>\n                <div class=\"leading-tight\" data-kid=\"2-1-1-1-2\" data-name=\"brand name and surface type\">\n                    <p class=\"text-[14px] font-semibold tracking-[-0.02em]\" data-kid=\"2-1-1-1-2-1\" data-name=\"brand name text\" style=\"font-family:var(--font-heading)\">\n                        DigiStore\n                    </p>\n                    <p class=\"text-[11px] text-[var(--muted)]\" data-kid=\"2-1-1-1-2-2\" data-name=\"brand surface type label\">\n                        Admin surface\n                    </p>\n                </div>\n            </div>\n            <nav aria-label=\"Admin sections\" class=\"min-w-0 flex-1 overflow-x-auto\" data-kid=\"2-1-1-2\" data-name=\"admin navigation\">\n                <div class=\"mx-auto flex w-max items-center gap-1 lg:gap-2\" data-kid=\"2-1-1-2-1\" data-name=\"nav links wrapper\">\n                    <button aria-current=\"page\" class=\"relative flex min-h-11 items-center gap-2 border-b-2 border-[var(--emerald)] px-3 text-[13px] font-semibold text-[var(--ink)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--emerald)] focus-visible:ring-offset-2\" data-kid=\"2-1-1-2-1-1\" data-name=\"discounts nav button\" type=\"button\">\n                        <i aria-hidden=\"true\" class=\"ti ti-ticket text-[16px] text-[var(--emerald)]\" data-kid=\"2-1-1-2-1-1-1\" data-name=\"discounts icon\" style=\"width:16px;height:16px\">\n                        </i>\n                        Discounts\n                    </button>\n                    <button class=\"flex min-h-11 items-center gap-2 border-b-2 border-transparent px-3 text-[13px] font-medium text-[var(--muted)] hover:text-[var(--ink)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--emerald)] focus-visible:ring-offset-2\" data-kid=\"2-1-1-2-1-2\" data-name=\"messages nav button\" type=\"button\">\n                        <i aria-hidden=\"true\" class=\"ti ti-message-square text-[16px] text-[var(--muted)]\" data-kid=\"2-1-1-2-1-2-1\" data-name=\"messages icon\" style=\"width:16px;height:16px\">\n                        </i>\n                        Messages\n                    </button>\n                    <button class=\"flex min-h-11 items-center gap-2 border-b-2 border-transparent px-3 text-[13px] font-medium text-[var(--muted)] hover:text-[var(--ink)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--emerald)] focus-visible:ring-offset-2\" data-kid=\"2-1-1-2-1-3\" data-name=\"geolocation nav button\" type=\"button\">\n                        <i aria-hidden=\"true\" class=\"ti ti-map-pin text-[16px] text-[var(--muted)]\" data-kid=\"2-1-1-2-1-3-1\" data-name=\"geolocation icon\" style=\"width:16px;height:16px\">\n                        </i>\n                        Geolocation\n                    </button>\n                </div>\n            </nav>\n            <div class=\"hidden shrink-0 items-center gap-2 md:flex\" data-kid=\"2-1-1-3\" data-name=\"header actions container\">\n                <button class=\"inline-flex min-h-9 items-center gap-2 rounded-md border border-[var(--line)] bg-[var(--surface)] px-3 text-[12px] font-semibold text-[var(--ink)] hover:bg-[var(--soft)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--emerald)] focus-visible:ring-offset-2\" data-kid=\"2-1-1-3-1\" data-name=\"refresh action button\" type=\"button\">\n                    <i aria-hidden=\"true\" class=\"ti ti-refresh text-[15px] text-[var(--muted)]\" data-kid=\"2-1-1-3-1-1\" data-name=\"refresh icon\" style=\"width:15px;height:15px\">\n                    </i>\n                    Refresh\n                </button>\n                <div class=\"inline-flex min-h-9 items-center gap-2 rounded-md border border-[var(--line)] px-3 text-[12px] font-semibold text-[var(--emerald-ink)]\" data-kid=\"2-1-1-3-2\" data-name=\"api status indicator\">\n                    <span aria-hidden=\"true\" class=\"h-2 w-2 rounded-full bg-[var(--emerald)]\" data-kid=\"2-1-1-3-2-1\" data-name=\"api status dot\">\n                    </span>\n                    API online\n                </div>\n                <button aria-label=\"Open operator menu\" class=\"flex h-9 w-9 items-center justify-center rounded-md border border-[var(--line)] bg-[var(--surface)] text-[var(--muted)] hover:bg-[var(--soft)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--emerald)] focus-visible:ring-offset-2\" data-kid=\"2-1-1-3-3\" data-name=\"operator menu button\" type=\"button\">\n                    <i aria-hidden=\"true\" class=\"ti ti-dots text-[17px] text-[var(--muted)]\" data-kid=\"2-1-1-3-3-1\" data-name=\"menu dots icon\" style=\"width:17px;height:17px\">\n                    </i>\n                </button>\n            </div>\n        </div>\n    </header>\n    <main class=\"mx-auto max-w-[1440px] px-4 py-7 sm:px-6 lg:px-8 lg:py-9\" data-kid=\"2-2\" data-name=\"main content area\">\n        <section aria-labelledby=\"page-title\" data-kid=\"2-2-1\" data-name=\"page header section\">\n            <div class=\"flex flex-col gap-5 border-b border-[var(--line)] pb-7 lg:flex-row lg:items-end lg:justify-between\" data-kid=\"2-2-1-1\" data-name=\"header content wrapper\">\n                <div data-kid=\"2-2-1-1-1\" data-name=\"page title group\">\n                    <div class=\"mb-3 flex flex-wrap items-center gap-2 text-[11px] font-semibold uppercase tracking-[0.16em] text-[var(--muted)]\" data-kid=\"2-2-1-1-1-1\" data-name=\"breadcrumb and api endpoint group\">\n                        <span data-kid=\"2-2-1-1-1-1-1\" data-name=\"promotion operations label\">\n                            Promotion operations\n                        </span>\n                        <span aria-hidden=\"true\" class=\"h-1 w-1 rounded-full bg-[var(--line)]\" data-kid=\"2-2-1-1-1-1-2\" data-name=\"breadcrumb separator\">\n                        </span>\n                        <code class=\"rounded border border-[var(--line)] bg-[var(--surface)] px-2 py-1 font-mono text-[10px] normal-case tracking-normal text-[var(--muted)]\" data-kid=\"2-2-1-1-1-1-3\" data-name=\"api endpoint code\">\n                            GET /api/v1/discount/all/get\n                        </code>\n                    </div>\n                    <h1 class=\"text-[30px] font-extrabold tracking-[-0.055em] text-[var(--ink)] sm:text-[36px]\" data-kid=\"2-2-1-1-1-2\" data-name=\"page main headline\" id=\"page-title\" style=\"font-family:var(--font-heading)\">\n                        Keep promotions in motion.\n                    </h1>\n                    <div class=\"mt-3 flex flex-wrap items-center gap-x-4 gap-y-2 text-[13px] text-[var(--muted)]\" data-kid=\"2-2-1-1-1-3\" data-name=\"sync metadata bar\">\n                        <span class=\"inline-flex items-center gap-2\" data-kid=\"2-2-1-1-1-3-1\" data-name=\"last sync status\">\n                            <i aria-hidden=\"true\" class=\"ti ti-clock text-[15px] text-[var(--muted)]\" data-kid=\"2-2-1-1-1-3-1-1\" data-name=\"clock icon\" style=\"width:15px;height:15px\">\n                            </i>\n                            Last sync just now\n                        </span>\n                        <span class=\"inline-flex items-center gap-2\" data-kid=\"2-2-1-1-1-3-2\" data-name=\"record count status\">\n                            <i aria-hidden=\"true\" class=\"ti ti-database text-[15px] text-[var(--muted)]\" data-kid=\"2-2-1-1-1-3-2-1\" data-name=\"database icon\" style=\"width:15px;height:15px\">\n                            </i>\n                            4 discount records\n                        </span>\n                    </div>\n                </div>\n                <button class=\"inline-flex min-h-11 items-center justify-center gap-2 rounded-md bg-[var(--emerald)] px-4 text-[13px] font-bold text-white hover:bg-[var(--emerald-ink)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--emerald)] focus-visible:ring-offset-2\" data-kid=\"2-2-1-1-2\" data-name=\"create code call-to-action\" type=\"button\">\n                    <i aria-hidden=\"true\" class=\"ti ti-plus text-[17px] text-white\" data-kid=\"2-2-1-1-2-1\" data-name=\"plus icon\" style=\"width:17px;height:17px\">\n                    </i>\n                    Create code\n                </button>\n            </div>\n        </section>\n        <section aria-labelledby=\"discounts-title\" class=\"mt-7 grid gap-5 lg:grid-cols-[300px_minmax(0,1fr)]\" data-kid=\"2-2-2\" data-name=\"discounts management section\" id=\"discounts\">\n            <div class=\"rounded-lg border border-[var(--line)] bg-[var(--surface)] p-5 lg:sticky lg:top-24 lg:self-start\" data-kid=\"2-2-2-1\" data-name=\"create discount form container\">\n                <div class=\"flex items-start justify-between gap-3 border-b border-[var(--line)] pb-4\" data-kid=\"2-2-2-1-1\" data-name=\"form header\">\n                    <div data-kid=\"2-2-2-1-1-1\" data-name=\"form title group\">\n                        <p class=\"text-[11px] font-bold uppercase tracking-[0.16em] text-[var(--emerald-ink)]\" data-kid=\"2-2-2-1-1-1-1\" data-name=\"create section label\">\n                            Create\n                        </p>\n                        <h2 class=\"mt-1 text-[17px] font-bold tracking-[-0.03em]\" data-kid=\"2-2-2-1-1-1-2\" data-name=\"discount code title\" id=\"discounts-title\" style=\"font-family:var(--font-heading)\">\n                            Discount code\n                        </h2>\n                    </div>\n                    <i aria-hidden=\"true\" class=\"ti ti-ticket text-[20px] text-[var(--emerald)]\" data-kid=\"2-2-2-1-1-2\" data-name=\"ticket icon\" style=\"width:20px;height:20px\">\n                    </i>\n                </div>\n                <p class=\"mt-4 text-[12px] leading-5 text-[var(--muted)]\" data-kid=\"2-2-2-1-2\" data-name=\"form description\">\n                    Mint a new code for the storefront. The API defaults\n                    <code class=\"font-mono text-[11px] text-[var(--ink)]\" data-kid=\"2-2-2-1-2-1\" data-name=\"inline code sample\">\n                        user_per_use\n                    </code>\n                    to 1 when omitted.\n                </p>\n                <form action=\"/api/v1/discount/create\" class=\"mt-5 space-y-4\" data-kid=\"2-2-2-1-3\" data-name=\"create discount form\" method=\"post\">\n                    <div data-kid=\"2-2-2-1-3-1\" data-name=\"code input group\">\n                        <label class=\"mb-1.5 block text-[12px] font-semibold text-[var(--ink)]\" data-kid=\"2-2-2-1-3-1-1\" data-name=\"code label\" for=\"discount-code\">\n                            Code\n                            <span class=\"text-[var(--rose)]\" data-kid=\"2-2-2-1-3-1-1-1\" data-name=\"required field asterisk\">\n                                *\n                            </span>\n                        </label>\n                        <input aria-describedby=\"discount-code-help\" class=\"h-10 w-full rounded-md border border-[var(--line)] bg-[var(--surface)] px-3 font-mono text-[13px] uppercase tracking-[0.08em] text-[var(--ink)] outline-none placeholder:text-[var(--muted)] focus:border-[var(--emerald)] focus-visible:ring-2 focus-visible:ring-[var(--emerald)]/20\" data-kid=\"2-2-2-1-3-1-2\" data-name=\"code input field\" id=\"discount-code\" name=\"code\" placeholder=\"SUMMER15\" required=\"\" type=\"text\" value=\"SUMMER15\"/>\n                        <p class=\"mt-1.5 text-[11px] text-[var(--muted)]\" data-kid=\"2-2-2-1-3-1-3\" data-name=\"code input helper text\" id=\"discount-code-help\">\n                            Must be unique.\n                        </p>\n                    </div>\n                    <div data-kid=\"2-2-2-1-3-2\" data-name=\"percent input group\">\n                        <label class=\"mb-1.5 block text-[12px] font-semibold text-[var(--ink)]\" data-kid=\"2-2-2-1-3-2-1\" data-name=\"percent label\" for=\"discount-percent\">\n                            Percent\n                            <span class=\"text-[var(--rose)]\" data-kid=\"2-2-2-1-3-2-1-1\" data-name=\"required field asterisk\">\n                                *\n                            </span>\n                        </label>\n                        <div class=\"relative\" data-kid=\"2-2-2-1-3-2-2\" data-name=\"percent input wrapper\">\n                            <input aria-describedby=\"discount-percent-help\" class=\"h-10 w-full rounded-md border border-[var(--line)] bg-[var(--surface)] px-3 pr-10 text-[13px] text-[var(--ink)] outline-none focus:border-[var(--emerald)] focus-visible:ring-2 focus-visible:ring-[var(--emerald)]/20\" data-kid=\"2-2-2-1-3-2-2-1\" data-name=\"percent input field\" id=\"discount-percent\" max=\"100\" min=\"1\" name=\"percent\" required=\"\" type=\"number\" value=\"15\"/>\n                            <span class=\"pointer-events-none absolute inset-y-0 right-3 flex items-center text-[13px] font-bold text-[var(--muted)]\" data-kid=\"2-2-2-1-3-2-2-2\" data-name=\"percent unit symbol\">\n                                %\n                            </span>\n                        </div>\n                        <p class=\"mt-1.5 text-[11px] text-[var(--muted)]\" data-kid=\"2-2-2-1-3-2-3\" data-name=\"percent input helper text\" id=\"discount-percent-help\">\n                            Accepts a whole number from 1–100.\n                        </p>\n                    </div>\n                    <div data-kid=\"2-2-2-1-3-3\" data-name=\"uses input group\">\n                        <label class=\"mb-1.5 block text-[12px] font-semibold text-[var(--ink)]\" data-kid=\"2-2-2-1-3-3-1\" data-name=\"uses label\" for=\"discount-uses\">\n                            Uses per user\n                        </label>\n                        <input class=\"h-10 w-full rounded-md border border-[var(--line)] bg-[var(--surface)] px-3 text-[13px] text-[var(--ink)] outline-none focus:border-[var(--emerald)] focus-visible:ring-2 focus-visible:ring-[var(--emerald)]/20\" data-kid=\"2-2-2-1-3-3-2\" data-name=\"uses input field\" id=\"discount-uses\" min=\"1\" name=\"user_per_use\" type=\"number\" value=\"1\"/>\n                    </div>\n                    <div class=\"border-t border-[var(--line)] pt-4\" data-kid=\"2-2-2-1-3-4\" data-name=\"form footer\">\n                        <button class=\"inline-flex min-h-10 w-full items-center justify-center gap-2 rounded-md bg-[var(--ink)] px-4 text-[12px] font-bold text-white hover:bg-[var(--emerald-ink)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--emerald)] focus-visible:ring-offset-2\" data-kid=\"2-2-2-1-3-4-1\" data-name=\"submit button\" type=\"submit\">\n                            <i aria-hidden=\"true\" class=\"ti ti-plus text-[16px] text-white\" data-kid=\"2-2-2-1-3-4-1-1\" data-name=\"plus icon\" style=\"width:16px;height:16px\">\n                            </i>\n                            Add discount code\n                        </button>\n                        <p class=\"mt-2 text-center text-[10px] text-[var(--muted)]\" data-kid=\"2-2-2-1-3-4-2\" data-name=\"api request label\">\n                            <code class=\"font-mono\" data-kid=\"2-2-2-1-3-4-2-1\" data-name=\"post request code\">\n                                POST /api/v1/discount/create\n                            </code>\n                        </p>\n                    </div>\n                </form>\n            </div>\n            <div class=\"min-w-0 rounded-lg border border-[var(--line)] bg-[var(--surface)]\" data-kid=\"2-2-2-2\" data-name=\"active codes table container\">\n                <div class=\"flex flex-col gap-4 border-b border-[var(--line)] p-5 sm:flex-row sm:items-center sm:justify-between\" data-kid=\"2-2-2-2-1\" data-name=\"table header group\">\n                    <div data-kid=\"2-2-2-2-1-1\" data-name=\"table title group\">\n                        <div class=\"flex items-center gap-2\" data-kid=\"2-2-2-2-1-1-1\" data-name=\"table title and count\">\n                            <h2 class=\"text-[17px] font-bold tracking-[-0.03em]\" data-kid=\"2-2-2-2-1-1-1-1\" data-name=\"table main title\" style=\"font-family:var(--font-heading)\">\n                                Active codes\n                            </h2>\n                            <span class=\"rounded-full bg-[var(--soft)] px-2 py-0.5 text-[10px] font-bold text-[var(--muted)]\" data-kid=\"2-2-2-2-1-1-1-2\" data-name=\"active codes count badge\">\n                                4 total\n                            </span>\n                        </div>\n                        <p class=\"mt-1 text-[12px] text-[var(--muted)]\" data-kid=\"2-2-2-2-1-1-2\" data-name=\"table description\">\n                            Fetched from the discount ledger.\n                        </p>\n                    </div>\n                    <div class=\"flex flex-col gap-2 sm:flex-row sm:items-center\" data-kid=\"2-2-2-2-1-2\" data-name=\"table controls\">\n                        <label class=\"relative block\" data-kid=\"2-2-2-2-1-2-1\" data-name=\"search input container\">\n                            <span class=\"sr-only\" data-kid=\"2-2-2-2-1-2-1-1\" data-name=\"search input sr label\">\n                                Search discount codes\n                            </span>\n                            <i aria-hidden=\"true\" class=\"ti ti-search pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-[15px] text-[var(--muted)]\" data-kid=\"2-2-2-2-1-2-1-2\" data-name=\"search icon\" style=\"width:15px;height:15px\">\n                            </i>\n                            <input class=\"h-9 w-full rounded-md border border-[var(--line)] bg-[var(--surface)] pl-9 pr-3 text-[12px] text-[var(--ink)] outline-none placeholder:text-[var(--muted)] focus:border-[var(--emerald)] focus-visible:ring-2 focus-visible:ring-[var(--emerald)]/20 sm:w-40\" data-kid=\"2-2-2-2-1-2-1-3\" data-name=\"search input field\" placeholder=\"Search codes\" type=\"search\"/>\n                        </label>\n                        <button aria-pressed=\"true\" class=\"inline-flex min-h-9 items-center justify-center gap-2 rounded-md border border-[var(--emerald)] bg-[var(--emerald)]/10 px-3 text-[12px] font-bold text-[var(--emerald-ink)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--emerald)] focus-visible:ring-offset-2\" data-kid=\"2-2-2-2-1-2-2\" data-name=\"filter action button\" type=\"button\">\n                            <i aria-hidden=\"true\" class=\"ti ti-filter text-[14px] text-[var(--emerald-ink)]\" data-kid=\"2-2-2-2-1-2-2-1\" data-name=\"filter icon\" style=\"width:14px;height:14px\">\n                            </i>\n                            Active only\n                        </button>\n                    </div>\n                </div>\n                <div class=\"overflow-x-auto\" data-kid=\"2-2-2-2-2\" data-name=\"table scroll wrapper\">\n                    <table class=\"min-w-[720px] w-full border-collapse text-left\" data-kid=\"2-2-2-2-2-1\" data-name=\"active codes data table\">\n                        <caption class=\"sr-only\" data-kid=\"2-2-2-2-2-1-1\" data-name=\"table hidden caption\">\n                            Discount code records\n                        </caption>\n                        <thead data-kid=\"2-2-2-2-2-1-2\" data-name=\"table header row group\">\n                            <tr class=\"border-b border-[var(--line)] bg-[var(--soft)] text-[10px] font-bold uppercase tracking-[0.14em] text-[var(--muted)]\" data-kid=\"2-2-2-2-2-1-2-1\" data-name=\"table header row\">\n                                <th class=\"px-5 py-3\" data-kid=\"2-2-2-2-2-1-2-1-1\" data-name=\"code header\" scope=\"col\">\n                                    Code\n                                </th>\n                                <th class=\"px-4 py-3\" data-kid=\"2-2-2-2-2-1-2-1-2\" data-name=\"percent header\" scope=\"col\">\n                                    Percent\n                                </th>\n                                <th class=\"px-4 py-3\" data-kid=\"2-2-2-2-2-1-2-1-3\" data-name=\"uses header\" scope=\"col\">\n                                    Uses per user\n                                </th>\n                                <th class=\"px-4 py-3\" data-kid=\"2-2-2-2-2-1-2-1-4\" data-name=\"state header\" scope=\"col\">\n                                    State\n                                </th>\n                                <th class=\"px-4 py-3\" data-kid=\"2-2-2-2-2-1-2-1-5\" data-name=\"created date header\" scope=\"col\">\n                                    Created\n                                </th>\n                                <th class=\"px-4 py-3\" data-kid=\"2-2-2-2-2-1-2-1-6\" data-name=\"actions header\" scope=\"col\">\n                                    <span class=\"sr-only\" data-kid=\"2-2-2-2-2-1-2-1-6-1\" data-name=\"actions header sr label\">\n                                        Actions\n                                    </span>\n                                </th>\n                            </tr>\n                        </thead>\n                        <tbody class=\"divide-y divide-[var(--line)] text-[13px]\" data-kid=\"2-2-2-2-2-1-3\" data-name=\"table body\">\n                            <tr class=\"hover:bg-[var(--soft)]\" data-kid=\"2-2-2-2-2-1-3-1\" data-name=\"table row 1\">\n                                <td class=\"px-5 py-4 font-mono font-bold tracking-[0.06em]\" data-kid=\"2-2-2-2-2-1-3-1-1\" data-name=\"code cell\">\n                                    SPRING20\n                                </td>\n                                <td class=\"px-4 py-4 font-semibold\" data-kid=\"2-2-2-2-2-1-3-1-2\" data-name=\"percent cell\">\n                                    20%\n                                </td>\n                                <td class=\"px-4 py-4 text-[var(--muted)]\" data-kid=\"2-2-2-2-2-1-3-1-3\" data-name=\"uses cell\">\n                                    5\n                                </td>\n                                <td class=\"px-4 py-4\" data-kid=\"2-2-2-2-2-1-3-1-4\" data-name=\"state cell\">\n                                    <span class=\"inline-flex items-c