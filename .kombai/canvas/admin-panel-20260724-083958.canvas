fset-2\" data-kid=\"2-2-3-3-3-2-3\" data-name=\"delete message button\" type=\"submit\">\n                            <i aria-hidden=\"true\" class=\"ti ti-trash text-[15px] text-white\" data-kid=\"2-2-3-3-3-2-3-1\" data-name=\"trash icon\" style=\"width:15px;height:15px\">\n                            </i>\n                            Delete message\n                        </button>\n                    </form>\n                </article>\n            </div>\n        </section>\n        <section aria-labelledby=\"geo-title\" class=\"mt-12 border-t border-[var(--line)] pt-8\" data-kid=\"2-2-4\" data-name=\"geolocation section\" id=\"geolocation\">\n            <div class=\"flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between\" data-kid=\"2-2-4-1\" data-name=\"geolocation header\">\n                <div data-kid=\"2-2-4-1-1\" data-name=\"geolocation title group\">\n                    <p class=\"text-[11px] font-bold uppercase tracking-[0.16em] text-[var(--emerald-ink)]\" data-kid=\"2-2-4-1-1-1\" data-name=\"read-only label\">\n                        Read-only probes\n                    </p>\n                    <h2 class=\"mt-2 text-[24px] font-extrabold tracking-[-0.045em]\" data-kid=\"2-2-4-1-1-2\" data-name=\"geolocation section title\" id=\"geo-title\" style=\"font-family:var(--font-heading)\">\n                        Geolocation bindings\n                    </h2>\n                    <p class=\"mt-2 max-w-2xl text-[13px] leading-6 text-[var(--muted)]\" data-kid=\"2-2-4-1-1-3\" data-name=\"geolocation section description\">\n                        Test the location lookup and city-based discount logic without changing stored data.\n                    </p>\n                </div>\n                <div class=\"flex items-center gap-2 text-[11px] text-[var(--muted)]\" data-kid=\"2-2-4-1-2\" data-name=\"service status group\">\n                    <span class=\"h-2 w-2 rounded-full bg-[var(--emerald)]\" data-kid=\"2-2-4-1-2-1\" data-name=\"service status dot\">\n                    </span>\n                    External location service connected\n                </div>\n            </div>\n            <div class=\"mt-5 grid gap-5 lg:grid-cols-[1.15fr_.85fr]\" data-kid=\"2-2-4-2\" data-name=\"geolocation content grid\">\n                <div class=\"relative min-h-[300px] overflow-hidden border border-[var(--line)] bg-[var(--soft)]\" data-kid=\"2-2-4-2-1\" data-name=\"map display container\">\n                    <img alt=\"Map detail by Fer Troulik on Unsplash\" class=\"h-full min-h-[300px] w-full object-cover opacity-90\" data-kid=\"2-2-4-2-1-1\" data-name=\"map background image\" decoding=\"async\" loading=\"lazy\" referrerpolicy=\"no-referrer\" src=\"https://images.unsplash.com/photo-1728985381714-8660eebcf9b5?auto=format&fit=crop&w=1000&q=80\"/>\n                    <div aria-hidden=\"true\" class=\"absolute inset-0 bg-[var(--ink)]/10\" data-kid=\"2-2-4-2-1-2\" data-name=\"map overlay layer\">\n                    </div>\n                    <div class=\"absolute left-[54%] top-[42%] flex h-10 w-10 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full border-4 border-white bg-[var(--rose)] text-white\" data-kid=\"2-2-4-2-1-3\" data-name=\"location pin marker\">\n                        <i aria-hidden=\"true\" class=\"ti ti-map-pin text-[19px] text-white\" data-kid=\"2-2-4-2-1-3-1\" data-name=\"location pin icon\" style=\"width:19px;height:19px\">\n                        </i>\n                    </div>\n                    <div class=\"absolute bottom-4 left-4 border border-white/60 bg-white/90 px-3 py-2\" data-kid=\"2-2-4-2-1-4\" data-name=\"location badge\">\n                        <p class=\"text-[10px] font-bold uppercase tracking-[0.14em] text-[var(--muted)]\" data-kid=\"2-2-4-2-1-4-1\" data-name=\"location badge label\">\n                            Location probe\n                        </p>\n                        <p class=\"mt-1 text-[13px] font-bold text-[var(--ink)]\" data-kid=\"2-2-4-2-1-4-2\" data-name=\"location coordinate text\">\n                            Tehran · IR\n                        </p>\n                    </div>\n                    <span class=\"absolute right-4 top-4 rounded border border-white/60 bg-white/90 px-2 py-1 font-mono text-[10px] text-[var(--ink)]\" data-kid=\"2-2-4-2-1-5\" data-name=\"map route code\">\n                        GET /v1/location/get\n                    </span>\n                </div>\n                <div class=\"space-y-3\" data-kid=\"2-2-4-2-2\" data-name=\"geolocation probes container\">\n                    <article class=\"border border-[var(--line)] bg-[var(--surface)] p-4\" data-kid=\"2-2-4-2-2-1\" data-name=\"location probe card\">\n                        <div class=\"flex items-start justify-between gap-3\" data-kid=\"2-2-4-2-2-1-1\" data-name=\"location probe header\">\n                            <div class=\"flex items-start gap-3\" data-kid=\"2-2-4-2-2-1-1-1\" data-name=\"location probe title group\">\n                                <div class=\"flex h-9 w-9 items-center justify-center rounded-md bg-[var(--soft)]\" data-kid=\"2-2-4-2-2-1-1-1-1\" data-name=\"location icon box\">\n                                    <i aria-hidden=\"true\" class=\"ti ti-world text-[18px] text-[var(--muted)]\" data-kid=\"2-2-4-2-2-1-1-1-1-1\" data-name=\"world icon\" style=\"width:18px;height:18px\">\n                                    </i>\n                                </div>\n                                <div data-kid=\"2-2-4-2-2-1-1-1-2\" data-name=\"location probe info\">\n                                    <h3 class=\"text-[14px] font-bold\" data-kid=\"2-2-4-2-2-1-1-1-2-1\" data-name=\"location probe title\">\n                                        Location probe\n                                    </h3>\n                                    <p class=\"mt-1 text-[12px] text-[var(--muted)]\" data-kid=\"2-2-4-2-2-1-1-1-2-2\" data-name=\"location probe city\">\n               