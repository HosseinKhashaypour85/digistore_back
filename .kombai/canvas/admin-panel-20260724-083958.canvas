id=\"2-1-2-2-2-1\" data-name=\"dispatch header\">\n                        <div class=\"flex items-start justify-between gap-3\" data-kid=\"2-1-2-2-2-1-1\" data-name=\"dispatch header title group\">\n                            <div class=\"flex items-center gap-2\" data-kid=\"2-1-2-2-2-1-1-1\" data-name=\"dispatch title icon group\">\n                                <span aria-hidden=\"true\" class=\"flex h-7 w-7 items-center justify-center rounded-lg bg-[#27272A] text-[#D4D4D8]\" data-kid=\"2-1-2-2-2-1-1-1-1\" data-name=\"dispatch icon container\">\n                                    <i class=\"ti ti-message-2 text-[16px] leading-none\" data-kid=\"2-1-2-2-2-1-1-1-1-1\" data-name=\"dispatch icon\">\n                                    </i>\n                                </span>\n                                <div data-kid=\"2-1-2-2-2-1-1-1-2\" data-name=\"dispatch title\">\n                                    <h2 class=\"text-base font-semibold tracking-tight text-[#FAFAFA] [font-family:'Space_Grotesk',sans-serif]\" data-kid=\"2-1-2-2-2-1-1-1-2-1\" data-name=\"dispatch header title\" id=\"message-dispatch-title\">\n                                        Message dispatch\n                                    </h2>\n                                    <p class=\"mt-1 text-xs text-[#71717A]\" data-kid=\"2-1-2-2-2-1-1-1-2-2\" data-name=\"dispatch description\">\n                                        Blind operations\n                                    </p>\n                                </div>\n                            </div>\n                            <code class=\"rounded-md bg-[#09090B] px-2 py-1 text-[10px] text-[#A1A1AA]\" data-kid=\"2-1-2-2-2-1-1-2\" data-name=\"dispatch routes count badge\">\n                                3 routes\n                            </code>\n                        </div>\n                        <div class=\"mt-4 flex items-start gap-2 rounded-lg border border-[#78350F] bg-[#291507] px-3 py-2.5 text-xs text-[#FDBA74]\" data-kid=\"2-1-2-2-2-1-2\" data-name=\"dispatch alert box\" role=\"alert\">\n                            <i aria-hidden=\"true\" class=\"ti ti-alert-triangle mt-0.5 text-[15px] leading-none\" data-kid=\"2-1-2-2-2-1-2-1\" data-name=\"alert triangle icon\">\n                            </i>\n                            <span data-kid=\"2-1-2-2-2-1-2-2\" data-name=\"alert message text\">\n                                <strong class=\"font-semibold text-[#FED7AA]\" data-kid=\"2-1-2-2-2-1-2-2-1\" data-name=\"alert message strong text\">\n                                    No GET /messages endpoint.\n                                </strong>\n                                Exact target ID required for update and delete.\n                            </span>\n                        </div>\n                    </div>\n                    <div class=\"space-y-2 p-4\" data-kid=\"2-1-2-2-2-2\" data-name=\"dispatch actions container\">\n                        <div class=\"rounded-lg border border-[#4C1D95] bg-[#20113F] p-3\" data-kid=\"2-1-2-2-2-2-1\" data-name=\"create message form section\">\n                            <div class=\"mb-3 flex items-center justify-between\" data-kid=\"2-1-2-2-2-2-1-1\" data-name=\"create message header\">\n                                <div class=\"flex items-center gap-2\" data-kid=\"2-1-2-2-2-2-1-1-1\" data-name=\"create message title group\">\n                                    <span class=\"flex h-6 w-6 items-center justify-center rounded-md bg-[#8B5CF6] text-white\" data-kid=\"2-1-2-2-2-2-1-1-1-1\" data-name=\"create message icon container\">\n                                        <i class=\"ti ti-plus text-[14px] leading-none\" data-kid=\"2-1-2-2-2-2-1-1-1-1-1\" data-name=\"create message plus icon\">\n                                        </i>\n                                    </span>\n                                    <span class=\"text-sm font-semibold text-[#F5F3FF]\" data-kid=\"2-1-2-2-2-2-1-1-1-2\" data-name=\"create message label\">\n                                        Create\n                                    </span>\n                                </div>\n                                <code class=\"text-[10px] text-[#C4B5FD]\" data-kid=\"2-1-2-2-2-2-1-1-2\" data-name=\"create message request type badge\">\n                                    POST\n                                </code>\n                            </div>\n                            <div class=\"space-y-2.5\" data-kid=\"2-1-2-2-2-2-1-2\" data-name=\"create message inputs\">\n                                <label class=\"block\" data-kid=\"2-1-2-2-2-2-1-2-1\" data-name=\"message title field\">\n                                    <span class=\"mb-1 block text-[11px] font-semibold text-[#C4B5FD]\" data-kid=\"2-1-2-2-2-2-1-2-1-1\" data-name=\"message title label\">\n                                        Title\n                                    </span>\n                                    <input class=\"min-h-11 w-full rounded-lg border border-[#5B21B6] bg-[#18181B] px-3 text-sm text-[#FAFAFA] outline-none focus:border-[#A78BFA] focus:ring-2 focus:ring-[#8B5CF6]/30\" data-kid=\"2-1-2-2-2-2-1-2-1-2\" data-name=\"message title input\" type=\"text\" value=\"Weekend offer is live\"/>\n                                </label>\n                                <label class=\"block\" data-kid=\"2-1-2-2-2-2-1-2-2\" data-name=\"message description field\">\n                                    <span class=\"mb-1 block text-[11px] font-semibold text-[#C4B5FD]\" data-kid=\"2-1-2-2-2-2-1-2-2-1\" data-name=\"message description label\">\n                                        Description\n                                    </span>\n                                    <textarea class=\"w-full resize-none rounded-lg border border-[#5B21B6] bg-[#18181B] px-3 py-2.5 text-sm text-[#FAFAFA] outline-none focus:border-[#A78BFA] focus:ring-2 focus:ring-[#8B5CF6]/30\" data-kid=\"2-1-2-2-2-2-1-2-2-2\" data-name=\"message description textarea\" rows=\"2\">20% off for Tehran customers.</textarea>\n                                </label>\n                                <button class=\"inline-flex min-h-11 w-full items-center justify-center gap-2 rounded-lg bg-[#8B5CF6] px-3 text-sm font-bold text-white hover:bg-[#7C3AED] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#A78BFA] focus-visible:ring-offset-2 focus-visible:ring-offset-[#20113F]\" data-kid=\"2-1-2-2-2-2-1-2-3\" data-name=\"create message button\" type=\"button\">\n                                    <i aria-hidden=\"true\" class=\"ti ti-send text-[16px] leading-none\" data-kid=\"2-1-2-2-2-2-1-2-3-1\" data-name=\"create message send icon\">\n                                    </i>\n                                    Create message\n                                </button>\n                            </div>\n                            <code class=\"mt-2 block text-[10px] text-[#71717A]\" data-kid=\"2-1-2-2-2-2-1-3\" data-name=\"create message API route info\">\n                                POST /api/v1/messages/create\n                            </code>\n                        </div>\n                        <div class=\"flex min-h-12 items-center justify-between rounded-lg border border-[#3F3F46] bg-[#1F1F22] px-3.5\" data-kid=\"2-1-2-2-2-2-2\" data-name=\"update message action button\">\n                            <div class=\"flex items-center gap-2\" data-kid=\"2-1-2-2-2-2-2-1\" data-name=\"update message label group\">\n                                <i aria-hidden=\"true\" class=\"ti ti-pencil text-[16px] leading-none text-[#A1A1AA]\" data-kid=\"2-1-2-2-2-2-2-1-1\" data-name=\"update message icon\">\n                                </i>\n                                <span class=\"text-sm font-semibold text-[#E4E4E7]\" data-kid=\"2-1-2-2-2-2-2-1-2\" data-name=\"update message label\">\n                                    Update\n                                </span>\n                            </div>\n                            <span class=\"text-[11px] text-[#71717A]\" data-kid=\"2-1-2-2-2-2-2-2\" data-name=\"update message sublabel\">\n                                requires Message ID\n                                <i aria-hidden=\"true\" class=\"ti ti-chevron-down ml-1 text-[14px] leading-none\" data-kid=\"2-1-2-2-2-2-2-2-1\" data-name=\"update message chevron icon\">\n                                </i>\n                            </span>\n                        </div>\n                        <div class=\"flex min-h-12 items-center justify-between rounded-lg border border-[#3F3F46] bg-[#1F1F22] px-3.5\" data-kid=\"2-1-2-2-2-2-3\" data-name=\"delete message action button\">\n                            <div class=\"flex items-center gap-2\" data-kid=\"2-1-2-2-2-2-3-1\" data-name=\"delete message label group\">\n                                <i aria-hidden=\"true\" class=\"ti ti-trash text-[16px] leading-none text-[#FB7185]\" data-kid=\"2-1-2-2-2-2-3-1-1\" data-name=\"delete message icon\">\n                                </i>\n                                <span class=\"text-sm font-semibold text-[#E4E4E7]\" data-kid=\"2-1-2-2-2-2-3-1-2\" data-name=\"delete message label\">\n                                    Delete\n                                </span>\n                            </div>\n                            <span class=\"text-[11px] text-[#71717A]\" data-kid=\"2-1-2-2-2-2-3-2\" data-name=\"delete message sublabel\">\n                                requires Message ID\n                                <i aria-hidden=\"true\" class=\"ti ti-chevron-down ml-1 text-[14px] leading-none\" data-kid=\"2-1-2-2-2-2-3-2-1\" data-name=\"delete message chevron icon\">\n                                </i>\n                            </span>\n                        </div>\n                    </div>\n                </article>\n                <article aria-labelledby=\"location-ping-title\" class=\"overflow-hidden rounded-xl border border-[#3F3F46] bg-[#18181B] lg:col-span-4\" data-kid=\"2-1-2-2-3\" data-name=\"location ping article\">\n                    <div class=\"flex flex-wrap items-start justify-between gap-3 border-b border-[#3F3F46] px-5 py-4\" data-kid=\"2-1-2-2-3-1\" data-name=\"location ping header\">\n                        <div class=\"flex items-center gap-2\" data-kid=\"2-1-2-2-3-1-1\" data-name=\"location ping title group\">\n                            <span aria-hidden=\"true\" class=\"flex h-7 w-7 items-center justify-center rounded-lg bg-[#14532D] text-[#86EFAC]\" data-kid=\"2-1-2-2-3-1-1-1\" data-name=\"location ping icon container\">\n                                <i class=\"ti ti-terminal-2 text-[16px] leading-none\" data-kid=\"2-1-2-2-3-1-1-1-1\" data-name=\"location ping icon\">\n                                </i>\n                            </span>\n                            <div data-kid=\"2-1-2-2-3-1-1-2\" data-name=\"location ping title and description\">\n                                <h2 class=\"text-base font-semibold tracking-tight text-[#FAFAFA] [font-family:'Space_Grotesk',sans-serif]\" data-kid=\"2-1-2-2-3-1-1-2-1\" data-name=\"location ping title\" id=\"location-ping-title\">\n                                    Location & promo ping\n                                </h2>\n                                <p class=\"mt-1 text-xs text-[#71717A]\" data-kid=\"2-1-2-2-3-1-1-2-2\" data-name=\"location ping description\">\n                                    Read-only diagnostic probes\n                                </p>\n                            </div>\n                        </div>\n                        <button class=\"inline-flex min-h-11 items-center gap-2 rounded-lg border border-[#6D28D9] bg-[#2E1065] px-3 text-xs font-bold text-[#DDD6FE] shadow-[0_0_0_3px_rgba(139,92,246,0.2)] hover:border-[#8B5CF6] hover:bg-[#4C1D95] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#A78BFA] focus-visible:ring-offset-2 focus-visible:ring-offset-[#18181B]\" data-kid=\"2-1-2-2-3-1-2\" data-name=\"execute location ping button\" type=\"button\">\n                            <i aria-hidden=\"true\" class=\"ti ti-player-play text-[15px] leading-none\" data-kid=\"2-1-2-2-3-1-2-1\" data-name=\"execute location ping play icon\">\n                            </i>\n                            Execute location ping\n                        </button>\n                    </div>\n                    <div class=\"px-5 py-4\" data-kid=\"2-1-2-2-3-2\" data-name=\"location ping body\">\n                        <div class=\"mb-3 flex flex-wrap gap-2 text-[10px] text-[#71717A]\" data-kid=\"2-1-2-2-3-2-1\" data-name=\"location ping API routes group\">\n                            <code class=\"rounded bg-[#09090B] px-2 py-1\" data-kid=\"2-1-2-2-3-2-1-1\" data-name=\"location ping route 1\">\n                                GET /api/v1/location/get\n                            </code>\n                            <code class=\"rounded bg-[#09090B] px-2 py-1\" data-kid=\"2-1-2-2-3-2-1-2\" data-name=\"location ping route 2\">\n                                GET /api/v1/discount/location/get\n                            </code>\n                        </div>\n                        <div aria-label=\"Location probe output\" class=\"overflow-hidden rounded-lg border border-[#27272A] bg-[#09090B] p-4 [font-family:ui-monospace,SFMono-Regular,Menlo,monospace]\" data-kid=\"2-1-2-2-3-2-2\" data-name=\"location ping probe output console\">\n                            <div class=\"mb-3 flex items-center gap-2 text-[11px] text-[#71717A]\" data-kid=\"2-1-2-2-3-2-2-1\" data-name=\"console traffic light icons\">\n                                <span class=\"h-2 w-2 rounded-full bg-[#F87171]\" data-kid=\"2-1-2-2-3-2-2-1-1\" data-name=\"console red dot\">\n                                </span>\n                                <span class=\"h-2 w-2 rounded-full bg-[#FBBF24]\" data-kid=\"2-1-2-2-3-2-2-1-2\" data-name=\"console yellow dot\">\n                                </span>\n                                <span class=\"h-2 w-2 rounded-full bg-[#4ADE80]\" data-kid=\"2-1-2-2-3-2-2-1-3\" data-name=\"console green dot\">\n                                </span>\n                                <span class=\"ml-2 text-[#52525B]\" data-kid=\"2-1-2-2-3-2-2-1-4\" data-name=\"console filename\">\n                                    probe.result.json\n                                </span>\n                            </div>\n                            <pre class=\"whitespace-pre-wrap text-[11px] leading-6 text-[#A7F3D0]\" data-kid=\"2-1-2-2-3-2-2-2\" data-name=\"console output\">$ execute --location --promo\n{\n  \"city\": \"Tehran\",\n  \"country\": \"IR\",\n  \"coordinates\": [35.6892, 51.3890],\n  \"discount\": 20,\n  \"success\": true,\n  \"message\": \"چون از شهر تهران هستید شما شامل 20 درصد تخفیف روی قیمت کل شدید!\"\n}\n<span class=\"text-[#4ADE80]\" data-kid=\"2-1-2-2-3-2-2-2-1\" data-name=\"probe success text\">✓ Probe complete</span> <span class=\"text-[#71717A]\" data-kid=\"2-1-2-2-3-2-2-2-2\" data-name=\"probe metadata text\">· 2 endpoints · 184ms</span></pre>\n                        </div>\n                    </div>\n                </article>\n            </section>\n            <footer class=\"flex flex-wrap items-center justify-between gap-2 border-t border-[#27272A] py-4 text-[11px] text-[#71717A]\" data-kid=\"2-1-2-3\" data-name=\"footer info bar\">\n                <span data-kid=\"2-1-2-3-1\" data-name=\"footer disclaimer text\">\n                    Read-only probes\n                    <span class=\"px-1 text-[#52525B]\" data-kid=\"2-1-2-3-1-1\" data-name=\"footer separator dot\">\n                        •\n                    </span>\n                    write actions require operator confirmation\n                </span>\n                <span class=\"flex items-center gap-2\" data-kid=\"2-1-2-3-2\" data-name=\"footer audit status group\">\n                    <i aria-hidden=\"true\" class=\"ti ti-shield-check text-[14px] leading-none text-[#86EFAC]\" data-kid=\"2-1-2-3-2-1\" data-name=\"footer audit icon\">\n                    </i>\n                    audit-ready session\n                </span>\n            </footer>\n        </main>\n    </div>\n</div>\n",
