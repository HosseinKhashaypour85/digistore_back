\"true\" data-kid=\"1-1-2-1-3-2-1-2-2\" data-name=\"table sync timestamp\" data-reason=\"text updated by script\">\n                                    4 records · synced just now\n                                </span>\n                            </div>\n                        </div>\n                        <form aria-labelledby=\"add-discount-title\" class=\"bg-slate-50/70 p-5\" data-kid=\"1-1-2-1-3-2-2\">\n                            <div class=\"flex items-start justify-between gap-3\" data-kid=\"1-1-2-1-3-2-2-1\">\n                                <div data-kid=\"1-1-2-1-3-2-2-1-1\">\n                                    <h3 class=\"text-sm font-semibold text-slate-950\" data-kid=\"1-1-2-1-3-2-2-1-1-1\" id=\"add-discount-title\">\n                                        Create discount\n                                    </h3>\n                                    <p class=\"mt-1 font-mono text-[10px] leading-4 text-slate-500\" data-kid=\"1-1-2-1-3-2-2-1-1-2\">\n                                        POST /api/v1/discount/create\n                                    </p>\n                                </div>\n                                <i aria-hidden=\"true\" class=\"ti ti-file-plus text-[19px] text-blue-600\" data-kid=\"1-1-2-1-3-2-2-1-2\">\n                                </i>\n                            </div>\n                            <div class=\"mt-5 space-y-4\" data-kid=\"1-1-2-1-3-2-2-2\">\n                                <div data-kid=\"1-1-2-1-3-2-2-2-1\">\n                                    <label class=\"block text-xs font-semibold text-slate-700\" data-kid=\"1-1-2-1-3-2-2-2-1-1\" for=\"discount-code\">\n                                        Code\n                                        <span class=\"text-blue-600\" data-kid=\"1-1-2-1-3-2-2-2-1-1-1\">\n                                            *\n                                        </span>\n                                    </label>\n                                    <input class=\"mt-1.5 h-11 w-full rounded-lg border border-slate-200 bg-white px-3 font-mono text-[13px] uppercase text-slate-900 placeholder:normal-case placeholder:text-slate-400 focus:border-blue-500 focus:outline-none focus:ring-3 focus:ring-blue-500/15\" data-kid=\"1-1-2-1-3-2-2-2-1-2\" id=\"discount-code\" name=\"code\" placeholder=\"e.g. SUMMER15\" type=\"text\"/>\n                                </div>\n                                <div data-kid=\"1-1-2-1-3-2-2-2-2\">\n                                    <label class=\"block text-xs font-semibold text-slate-700\" data-kid=\"1-1-2-1-3-2-2-2-2-1\" for=\"discount-percent\">\n                                        Percent\n                                        <span class=\"text-blue-600\" data-kid=\"1-1-2-1-3-2-2-2-2-1-1\">\n                                            *\n                                        </span>\n                                    </label>\n                                    <div class=\"relative mt-1.5\" data-kid=\"1-1-2-1-3-2-2-2-2-2\">\n                                        <input class=\"h-11 w-full rounded-lg border border-slate-200 bg-white px-3 pr-9 text-sm text-slate-900 placeholder:text-slate-400 focus:border-blue-500 focus:outline-none focus:ring-3 focus:ring-blue-500/15\" data-kid=\"1-1-2-1-3-2-2-2-2-2-1\" id=\"discount-percent\" max=\"100\" min=\"1\" name=\"percent\" placeholder=\"20\" type=\"number\"/>\n                                        <span class=\"pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-sm text-slate-400\" data-kid=\"1-1-2-1-3-2-2-2-2-2-2\">\n                                            %\n                                        </span>\n                                    </div>\n                                    <p class=\"mt-1 text-[10px] text-slate-500\" data-kid=\"1-1-2-1-3-2-2-2-2-3\">\n                                        Must be between 1 and 100.\n                                    </p>\n                                </div>\n                                <div data-kid=\"1-1-2-1-3-2-2-2-3\">\n                                    <label class=\"block text-xs font-semibold text-slate-700\" data-kid=\"1-1-2-1-3-2-2-2-3-1\" for=\"discount-uses\">\n                                        Uses per user\n                                    </label>\n                                    <input class=\"mt-1.5 h-11 w-full rounded-lg border border-slate-200 bg-white px-3 text-sm text-slate-900 placeholder:text-slate-400 focus:border-blue-500 focus:outline-none focus:ring-3 focus:ring-blue-500/15\" data-kid=\"1-1-2-1-3-2-2-2-3-2\" id=\"discount-uses\" min=\"1\" name=\"user_per_use\" placeholder=\"1\" type=\"number\"/>\n                                    <p class=\"mt-1 text-[10px] text-slate-500\" data-kid=\"1-1-2-1-3-2-2-2-3-3\">\n                                        Defaults to 1 when omitted.\n                                    </p>\n                                </div>\n                                <button class=\"inline-flex min-h-11 w-full items-center justify-center gap-2 rounded-lg bg-blue-600 px-4 text-sm font-semibold text-white hover:bg-blue-700 focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-blue-500/30\" data-kid=\"1-1-2-1-3-2-2-2-4\" type=\"submit\">\n                                    <i aria-hidden=\"true\" class=\"ti ti-plus text-[17px] text-white\" data-kid=\"1-1-2-1-3-2-2-2-4-1\">\n                                    </i>\n                                    Create code\n                                </button>\n                            </div>\n                        </form>\n                    </div>\n                </section>\n                <section class=\"mt-7 grid gap-4 xl:grid-cols-[minmax(0,1fr)_minmax(320px,0.82fr)]\" data-kid=\"1-1-2-1-4\" id=\"messages\">\n                    <div class=\"border border-slate-200 bg-white shadow-xs\" data-kid=\"1-1-2-1-4-1\">\n                        <div class=\"border-b border-slate-200 px-5 p