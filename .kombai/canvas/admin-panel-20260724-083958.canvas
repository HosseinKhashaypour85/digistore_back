      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@600&display=swap');\n  .font-inter { font-family: 'Inter', ui-sans-serif, system-ui, sans-serif; }\n  .font-mono { font-family: 'DM Mono', ui-monospace, SFMono-Regular, Menlo, monospace; }\n  .font-editorial { font-family: 'Playfair Display', Georgia, serif; }\n</style>\n<div class=\"font-inter min-h-screen bg-slate-50 text-slate-900\" data-kid=\"1\">\n    <div class=\"flex min-h-screen flex-col lg:flex-row\" data-kid=\"1-1\">\n        <aside class=\"flex w-full shrink-0 flex-col bg-slate-900 text-slate-300 lg:min-h-screen lg:w-60\" data-kid=\"1-1-1\">\n            <div class=\"flex items-center justify-between border-b border-white/10 px-5 py-5 lg:block\" data-kid=\"1-1-1-1\">\n                <div data-kid=\"1-1-1-1-1\">\n                    <div class=\"font-editorial text-[18px] font-semibold tracking-tight text-white\" data-kid=\"1-1-1-1-1-1\">\n                        DigiStore\n                    </div>\n                    <div class=\"mt-0.5 text-[10px] font-semibold uppercase tracking-[0.24em] text-slate-500\" data-kid=\"1-1-1-1-1-2\">\n                        operations\n                    </div>\n                </div>\n                <button aria-label=\"Open navigation\" class=\"inline-flex min-h-11 min-w-11 items-center justify-center rounded-lg border border-white/10 text-slate-300 hover:bg-white/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-400 lg:hidden\" data-kid=\"1-1-1-1-2\">\n                    <i aria-hidden=\"true\" class=\"ti ti-menu-2 text-[20px] text-slate-200\" data-kid=\"1-1-1-1-2-1\">\n                    </i>\n                </button>\n            </div>\n            <div class=\"hidden flex-1 lg:flex lg:flex-col\" data-kid=\"1-1-1-2\">\n                <div class=\"px-4 pt-6\" data-kid=\"1-1-1-2-1\">\n                    <p class=\"px-3 text-[10px] font-semibold uppercase tracking-[0.2em] text-slate-500\" data-kid=\"1-1-1-2-1-1\">\n                        Workspace\n                    </p>\n                    <nav aria-label=\"Admin sections\" class=\"mt-3 space-y-1\" data-kid=\"1-1-1-2-1-2\">\n                        <a class=\"flex min-h-11 items-center gap-3 rounded-lg px-3 text-sm text-slate-400 hover:bg-white/5 hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-400\" data-kid=\"1-1-1-2-1-2-1\" href=\"#overview\">\n                            <i aria-hidden=\"true\" class=\"ti ti-layout-dashboard text-[18px] text-slate-500\" data-kid=\"1-1-1-2-1-2-1-1\">\n                            </i>\n                            <span data-kid=\"1-1-1-2-1-2-1-2\">\n                                Overview\n                            </span>\n                        </a>\n                        <a aria-current=\"page\" class=\"flex min-h-11 items-center gap-3 rounded-lg bg-blue-600 px-3 text-sm font-semibold text-white shadow-sm shadow-blue-950/30 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-300\" data-kid=\"1-1-1-2-1-2-2\" href=\"#discounts\">\n                            <i aria-hidden=\"true\" class=\"ti ti-ticket text-[18px] text-white\" data-kid=\"1-1-1-2-1-2-2-1\">\n                            </i>\n                            <span data-kid=\"1-1-1-2-1-2-2-2\">\n                                Discounts\n                            </span>\n                            <span class=\"ml-auto rounded bg-white/15 px-1.5 py-0.5 text-[10px] font-medium text-blue-50\" data-dynamic=\"true\" data-kid=\"1-1-1-2-1-2-2-3\" data-name=\"active discount code count\" data-reason=\"text updated via API data\">\n                                04\n                            </span>\n                        </a>\n                        <a class=\"flex min-h-11 items-center gap-3 rounded-lg px-3 text-sm text-slate-400 hover:bg-white/5 hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-400\" data-kid=\"1-1-1-2-1-2-3\" href=\"#messages\">\n                            <i aria-hidden=\"true\" class=\"ti ti-message-square text-[18px] text-slate-500\" data-kid=\"1-1-1-2-1-2-3-1\">\n                            </i>\n                            <span data-kid=\"1-1-1-2-1-2-3-2\">\n                                Messages\n                            </span>\n                        </a>\n                        <a class=\"flex min-h-11 items-center gap-3 rounded-lg px-3 text-sm text-slate-400 hover:bg-white/5 hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-400\" data-kid=\"1-1-1-2-1-2-4\" href=\"#location\">\n                            <i aria-hidden=\"true\" class=\"ti ti-map-pin text-[18px] text-slate-500\" data-kid=\"1-1-1-2-1-2-4-1\">\n                            </i>\n                            <span data-kid=\"1-1-1-2-1-2-4-2\">\n                                Location\n                            </span>\n                        </a>\n                    </nav>\n                </div>\n                <div class=\"mt-auto border-t border-white/10 px-4 py-5\" data-kid=\"1-1-1-2-2\">\n                    <div class=\"rounded-lg border border-white/10 bg-white/[0.03] p-3\" data-kid=\"1-1-1-2-2-1\">\n                        <div class=\"flex items-start gap-2.5\" data-kid=\"1-1-1-2-2-1-1\">\n                            <i aria-hidden=\"true\" class=\"ti ti-plug-connected text-[17px] text-emerald-400\" data-dynamic=\"true\" data-kid=\"1-1-1-2-2-1-1-1\" data-name=\"API status indicator icon\" data-reason=\"color updated via API connectivity status\">\n                            </i>\n                            <div data-kid=\"1-1-1-2-2-1-1-2\">\n                                <p class=\"text-xs font-semibold text-slate-200\" data-dynamic=\"true\" data-kid=\"1-1-1-2-2-1-1-2-1\" data-name=\"API status text\" data-reason=\"text updated via API connectivity status\">\n                                    API surface online\n                                </p>\n                                <p class=\"mt-1 text-[11px] leading-4 text-slate-500\" data-dynamic=\"true\" data-kid=\"1-1-1-2-2-1-1-2-2\" data-name=\"API status description text\" data-reason=\"text updated via API connectivity status\">\n                                    Express routes are ready for live data.\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"mt-5 flex items-center gap-3 px-2\" data-kid=\"1-1-1-2-2-2\">\n                        <div class=\"flex h-8 w-8 items-center justify-center rounded-full bg-slate-700 text-[11px] font-semibold text-slate-200\" data-kid=\"1-1-1-2-2-2-1\">\n                            HK\n                        </div>\n                        <div class=\"min-w-0\" data-kid=\"1-1-1-2-2-2-2\">\n                            <p class=\"truncate text-xs font-medium text-slate-200\" data-kid=\"1-1-1-2-2-2-2-1\">\n                                Hossein Khashaypour\n                            </p>\n                            <p class=\"text-[11px] text-slate-500\" data-kid=\"1-1-1-2-2-2-2-2\">\n                                Operator\n                            </p>\n                        </div>\n                        <button aria-label=\"Open operator menu\" class=\"ml-auto inline-flex min-h-11 min-w-11 items-center justify-center rounded-lg text-slate-500 hover:bg-white/10 hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-400\" data-kid=\"1-1-1-2-2-2-3\" title=\"Operator menu\">\n                            <i aria-hidden=\"true\" class=\"ti ti-dots text-[18px]\" data-kid=\"1-1-1-2-2-2-3-1\">\n                            </i>\n                        </button>\n                    </div>\n                </div>\n            </div>\n        </aside>\n        <main class=\"min-w-0 flex-1\" data-kid=\"1-1-2\">\n            <div class=\"mx-auto max-w-[1440px] px-5 py-6 sm:px-8 lg:px-10 lg:py-8\" data-kid=\"1-1-2-1\">\n                <header class=\"flex flex-col gap-5 border-b border-slate-200 pb-6 md:flex-row md:items-start md:justify-between\" data-kid=\"1-1-2-1-1\" id=\"overview\">\n                    <div data-kid=\"1-1-2-1-1-1\">\n                        <div class=\"flex items-center gap-2 text-xs font-medium text-slate-500\" data-kid=\"1-1-2-1-1-1-1\">\n                            <span data-kid=\"1-1-2-1-1-1-1-1\">\n                                Admin\n                            </span>\n                            <i aria-hidden=\"true\" class=\"ti ti-chevron-right text-[14px] text-slate-400\" data-kid=\"1-1-2-1-1-1-1-2\">\n                            </i>\n                            <span class=\"text-slate-700\" data-kid=\"1-1-2-1-1-1-1-3\">\n                                Operations\n                            </span>\n                        </div>\n                        <h1 class=\"mt-3 text-[28px] font-semibold tracking-[-0.03em] text-slate-950 sm:text-[32px]\" data-kid=\"1-1-2-1-1-1-2\">\n                            Admin control center\n                        </h1>\n                        <p class=\"mt-1.5 text-sm text-slate-500\" data-kid=\"1-1-2-1-1-1-3\">\n                            Manage promotions, messages, and location bindings.\n                        </p>\n                    </div>\n                    <div class=\"flex items-center gap-3\" data-kid=\"1-1-2-1-1-2\">\n                        <div class=\"flex items-center gap-2 rounded-full border border-emerald-200 bg-emerald-50 px-3 py-2 text-xs font-semibold text-emerald-700\" data-dynamic=\"true\" data-kid=\"1-1-2-1-1-2-1\" data-name=\"API status badge\" data-reason=\"text/status updated via API\">\n                            <span class=\"h-2 w-2 rounded-full bg-emerald-500\" data-dynamic=\"true\" data-kid=\"1-1-2-1-1-2-1-1\" data-name=\"API status indicator dot\" data-reason=\"status updated via API\">\n                            </span>\n                            API online\n                        </div>\n                        <button aria-label=\"Refresh API data\" class=\"inline-flex min-h-11 min-w-11 items-center justify-center rounded-lg border border-slate-200 bg-white text-slate-600 hover:border-slate-300 hover:bg-slate-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500\" data-kid=\"1-1-2-1-1-2-2\" title=\"Refresh API data\">\n                            <i aria-hidden=\"true\" class=\"ti ti-refresh text-[18px] text-slate-600\" data-kid=\"1-1-2-1-1-2-2-1\">\n                            </i>\n                        </button>\n                        <div aria-label=\"Operator initials\" class=\"flex h-10 w-10 items-center justify-center rounded-full bg-slate-900 text-xs font-semibold text-white\" data-kid=\"1-1-2-1-1-2-3\">\n                            HK\n                        </div>\n                    </div>\n                </header>\n                <section aria-label=\"Operational summary\" class=\"mt-6 grid gap-3 md:grid-cols-3\" data-kid=\"1-1-2-1-2\">\n                    <div class=\"border-l-2 border-blue-600 bg-white px-4 py-3 shadow-xs ring-1 ring-slate-200/70\" data-kid=\"1-1-2-1-2-1\">\n                        <p class=\"text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-500\" data-kid=\"1-1-2-1-2-1-1\">\n                            Active discount codes\n                        </p>\n                        <div class=\"mt-1 flex items-end justify-between\" data-kid=\"1-1-2-1-2-1-2\">\n                            <p class=\"text-2xl font-semibold tracking-tight text-slate-950\" data-dynamic=\"true\" data-kid=\"1-1-2-1-2-1-2-1\" data-name=\"active discount count\" data-reason=\"number updated via API\">\n                                04\n                            </p>\n                            <span class=\"text-xs font-medium text-emerald-600\" data-kid=\"1-1-2-1-2-1-2-2\">\n                                3 active\n                            </span>\n                        </div>\n                    </div>\n                    <div class=\"border-l-2 border-slate-400 bg-white px-4 py-3 shadow-xs ring-1 ring-slate-200/70\" data-kid=\"1-1-2-1-2-2\">\n                        <p class=\"text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-500\" data-kid=\"1-1-2-1-2-2-1\">\n                            Message actions\n                        </p>\n                        <div class=\"mt-1 flex items-end justify-between\" data-kid=\"1-1-2-1-2-2-2\">\n                            <p class=\"text-2xl font-semibold tracking-tight text-slate-950\" data-dynamic=\"true\" data-kid=\"1-1-2-1-2-2-2-1\" data-name=\"message action count\" data-reason=\"number updated via API\">\n                                03\n                            </p>\n                            <span class=\"text-xs font-medium text-slate-500\" data-kid=\"1-1-2-1-2-2-2-2\">\n                                create · update · delete\n                            </span>\n                        </div>\n                    </div>\n                    <div class=\"border-l-2 border-amber-500 bg-white px-4 py-3 shadow-xs ring-1 ring-slate-200/70\" data-kid=\"1-1-2-1-2-3\">\n                        <p class=\"text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-500\" data-kid=\"1-1-2-1-2-3-1\">\n                            Location probes\n                        </p>\n                        <div class=\"mt-1 flex items-end justify-between\" data-kid=\"1-1-2-1-2-3-2\">\n                            <p class=\"text-2xl font-semibold tracking-tight text-slate-950\" data-kid=\"1-1-2-1-2-3-2-1\">\n                                Read-only\n                            </p>\n                            <span class=\"text-xs font-medium text-amber-700\" data-kid=\"1-1-2-1-2-3-2