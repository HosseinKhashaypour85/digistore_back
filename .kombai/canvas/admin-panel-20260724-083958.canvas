      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Fira+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap');\n</style>\n<link data-kid=\"1\" data-name=\"Tabler icons stylesheet link\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<div class=\"min-h-screen bg-[#09090B] px-5 py-4 text-[#F4F4F5] [font-family:'Fira_Sans',sans-serif] sm:px-7 lg:px-9\" data-kid=\"2\" data-name=\"page layout container\">\n    <div class=\"mx-auto max-w-[1450px]\" data-kid=\"2-1\" data-name=\"main content layout wrapper\">\n        <header aria-label=\"Control room utility bar\" class=\"flex min-h-14 flex-wrap items-center justify-between gap-3 border-b border-[#27272A] pb-4\" data-kid=\"2-1-1\" data-name=\"utility bar header\">\n            <div class=\"flex items-center gap-3\" data-kid=\"2-1-1-1\" data-name=\"branding and workspace info group\">\n                <div aria-hidden=\"true\" class=\"flex h-10 w-10 items-center justify-center rounded-xl border border-[#4C1D95] bg-[#2E1065] text-lg text-[#A78BFA]\" data-kid=\"2-1-1-1-1\" data-name=\"command icon container\">\n                    <i class=\"ti ti-command text-[20px] leading-none\" data-kid=\"2-1-1-1-1-1\" data-name=\"command icon\">\n                    </i>\n                </div>\n                <div data-kid=\"2-1-1-1-2\" data-name=\"workspace details group\">\n                    <div class=\"flex items-center gap-2 text-sm font-semibold tracking-tight text-[#FAFAFA] [font-family:'Space_Grotesk',sans-serif]\" data-kid=\"2-1-1-1-2-1\" data-name=\"workspace name with separator\">\n                        DigiStore\n                        <span class=\"text-[#52525B]\" data-kid=\"2-1-1-1-2-1-1\" data-name=\"separator slash\">\n                            /\n                        </span>\n                        control room\n                    </div>\n                    <div class=\"mt-0.5 text-xs text-[#71717A]\" data-kid=\"2-1-1-1-2-2\" data-name=\"operator status description\">\n                        Operator workspace · production bindings\n                    </div>\n                </div>\n            </div>\n            <div class=\"flex flex-wrap items-center gap-2 text-xs\" data-kid=\"2-1-1-2\" data-name=\"utility controls group\">\n                <div class=\"flex min-h-10 items-center gap-2 rounded-lg border border-[#14532D] bg-[#052E16] px-3 text-[#86EFAC]\" data-kid=\"2-1-1-2-1\" data-name=\"connection status indicator\" role=\"status\">\n                    <span aria-hidden=\"true\" class=\"h-2 w-2 rounded-full bg-[#4ADE80] shadow-[0_0_0_3px_rgba(74,222,128,0.12)]\" data-kid=\"2-1-1-2-1-1\" data-name=\"connection pulse dot\">\n                    </span>\n                    <span class=\"font-semibold\" data-kid=\"2-1-1-2-1-2\" data-name=\"connection status text\">\n                        API connected\n                    </span>\n                </div>\n                <div class=\"flex min-h-10 items-center gap-2 rounded-lg border border-[#27272A] bg-[#18181B] px-3 text-[#A1A1AA]\" data-kid=\"2-1-1-2-2\" data-name=\"API endpoint indicator\">\n                    <span class=\"text-[#52525B]\" data-kid=\"2-1-1-2-2-1\" data-name=\"endpoint type label\">\n                        base\n                    </span>\n                    <code class=\"text-[#D4D4D8]\" data-kid=\"2-1-1-2-2-2\" data-name=\"endpoint path text\">\n                        /api/v1\n                    </code>\n                </div>\n                <button class=\"inline-flex min-h-10 items-center gap-2 rounded-lg border border-[#3F3F46] bg-[#27272A] px-3 text-sm font-semibold text-[#E4E4E7] hover:border-[#71717A] hover:bg-[#3F3F46] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#8B5CF6] focus-visible:ring-offset-2 focus-visible:ring-offset-[#09090B]\" data-kid=\"2-1-1-2-3\" data-name=\"refresh data button\" type=\"button\">\n                    <i aria-hidden=\"true\" class=\"ti ti-refresh text-[16px] leading-none text-[#A78BFA]\" data-kid=\"2-1-1-2-3-1\" data-name=\"refresh icon\">\n                    </i>\n                    Refresh data\n                </button>\n            </div>\n        </header>\n        <main class=\"pt-5\" data-kid=\"2-1-2\" data-name=\"main application grid section\">\n            <section aria-label=\"Operational overview\" class=\"grid grid-cols-1 gap-3 sm:grid-cols-2 xl:grid-cols-4\" data-kid=\"2-1-2-1\" data-name=\"operational overview dashboard section\">\n                <div class=\"flex min-h-[82px] items-center justify-between rounded-xl border border-[#3F3F46] bg-[#18181B] px-4 py-3\" data-kid=\"2-1-2-1-1\" data-name=\"discounts metric card\">\n                    <div data-kid=\"2-1-2-1-1-1\" data-name=\"discounts metric label and value group\">\n                        <p class=\"text-[11px] font-semibold uppercase tracking-[0.16em] text-[#71717A]\" data-kid=\"2-1-2-1-1-1-1\" data-name=\"discounts label\">\n                            Discounts\n                        </p>\n                        <p class=\"mt-1 text-xl font-semibold tracking-tight text-[#FAFAFA] [font-family:'Space_Grotesk',sans-serif]\" data-kid=\"2-1-2-1-1-1-2\" data-name=\"discounts count\">\n                            4 loaded\n                        </p>\n                    </div>\n                    <div aria-hidden=\"true\" class=\"flex h-9 w-9 items-center justify-center rounded-lg bg-[#2E1065] text-base text-[#A78BFA]\" data-kid=\"2-1-2-1-1-2\" data-name=\"discounts icon container\">\n                        <i class=\"ti ti-ticket text-[18px] leading-none\" data-kid=\"2-1-2-1-1-2-1\" data-name=\"discounts icon\">\n                        </i>\n                    </div>\n                </div>\n                <div class=\"flex min-h-[82px] items-center justify-between rounded-xl border border-[#3F3F46] bg-[#18181B] px-4 py-3\" data-kid=\"2-1-2-1-2\" data-name=\"message API metric card\">\n                    <div data-kid=\"2-1-2-1-2-1\" data-name=\"message API label and value group\">\n                        <p class=\"text-[11px] font-semibold uppercase tracking-[0.16em] text-[#71717A]\" data-kid=\"2-1-2-1-2-1-1\" data-name=\"message API label\">\n                            Message API\n                        </p>\n                        <p class=\"mt-1 text-xl font-semibold tracking-tight text-[#FAFAFA] [font-family:'Space_Grotesk',sans-serif]\" data-kid=\"2-1-2-1-2-1-2\" data-name=\"message API count\">\n                            3 actions\n                        </p>\n                    </div>\n                    <div aria-hidden=\"true\" class=\"flex h-9 w-9 items-center justify-center rounded-lg bg-[#27272A] text-base text-[#D4D4D8]\" data-kid=\"2-1-2-1-2-2\" data-name=\"message API icon container\">\n                        <i class=\"ti ti-message-2 text-[18px] leading-none\" data-kid=\"2-1-2-1-2-2-1\" data-name=\"message API icon\">\n                        </i>\n                    </div>\n                </div>\n                <div class=\"flex min-h-[82px] items-center justify-between rounded-xl border border-[#14532D] bg-[#052E16] px-4 py-3\" data-kid=\"2-1-2-1-3\" data-name=\"location metric card\">\n                    <div data-kid=\"2-1-2-1-3-1\" data-name=\"location label and value group\">\n                        <p class=\"text-[11px] font-semibold uppercase tracking-[0.16em] text-[#86EFAC]/70\" data-kid=\"2-1-2-1-3-1-1\" data-name=\"location label\">\n                            Location\n                        </p>\n                        <p class=\"mt-1 text-xl font-semibold tracking-tight text-[#DCFCE7] [font-family:'Space_Grotesk',sans-serif]\" data-kid=\"2-1-2-1-3-1-2\" data-name=\"location status\">\n                            Ready\n                        </p>\n                    </div>\n                    <div aria-hidden=\"true\" class=\"flex h-9 w-9 items-center justify-center rounded-lg bg-[#14532D] text-base text-[#86EFAC]\" data-kid=\"2-1-2-1-3-2\" data-name=\"location icon container\">\n                        <i class=\"ti ti-map-pin text-[18px] leading-none\" data-kid=\"2-1-2-1-3-2-1\" data-name=\"location icon\">\n                        </i>\n                    </div>\n                </div>\n                <div class=\"flex min-h-[82px] items-center justify-between rounded-xl border border-[#78350F] bg-[#291507] px-4 py-3\" data-kid=\"2-1-2-1-4\" data-name=\"messages list status card\">\n                    <div data-kid=\"2-1-2-1-4-1\" data-name=\"messages list label and value group\">\n                        <p class=\"text-[11px] font-semibold uppercase tracking-[0.16em] text-[#FDBA74]/70\" data-kid=\"2-1-2-1-4-1-1\" data-name=\"messages list label\">\n                            Messages list\n                        </p>\n                        <p class=\"mt-1 text-xl font-semibold tracking-tight text-[#FED7AA] [font-family:'Space_Grotesk',sans-serif]\" data-kid=\"2-1-2-1-4-1-2\" data-name=\"messages list status\">\n                            Unavailable\n                        </p>\n                    </div>\n                    <div aria-hidden=\"true\" class=\"flex h-9 w-9 items-center justify-center rounded-lg bg-[#451A03] text-base text-[#FDBA74]\" data-kid=\"2-1-2-1-4-2\" data-name=\"messages list icon container\">\n                        <i class=\"ti ti-database-off text-[18px] leading-none\" data-kid=\"2-1-2-1-4-2-1\" data-name=\"messages list icon\">\n                        </i>\n                    </div>\n                </div>\n            </section>\n            <section aria-label=\"API operations workspace\" class=\"mt-5 grid grid-cols-1 gap-4 lg:grid-cols-12 lg:items-start\" data-kid=\"2-1-2-2\" data-name=\"API operations workspace grid section\">\n                <article aria-labelledby=\"discount-ledger-title\" class=\"overflow-hidden rounded-xl border border-[#3F3F46] bg-[#18181B] lg:col-span-8 lg:row-span-2\" data-kid